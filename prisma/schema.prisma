// GarageOS foundation adapted from Mecanico_Management; see docs/reuse-audit.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["garageos"]
}

model Shop {
  salesDemo SalesDemo?
  defaultLanguage    InvoiceLanguage     @default(FR)
  workOrders         WorkOrder[]
  inspections        Inspection[]
  inventoryParts     InventoryPart[]
  inventoryMovements InventoryMovement[]
  importRuns         ImportRun[]
  tireStorageSets    TireStorageSet[]
  tireStorageEvents  TireStorageEvent[]
  inspectionTemplates InspectionTemplate[]
  reminderRules      ReminderRule[]
  userAccess         UserShopAccess[]
  staffNotifications StaffNotification[]
  documentSequences  DocumentSequence[]
  invoiceRefunds     InvoiceRefund[]
  financialEvents    FinancialEvent[]
  quickBooksConnection QuickBooksConnection?
  quickBooksSyncRecords QuickBooksSyncRecord[]
  quickBooksOAuthStates QuickBooksOAuthState[]
  customerPortalAccesses CustomerPortalAccess[]
  platformNotes              PlatformNote[]
  platformAuditLogs          PlatformAuditLog[]
  platformConversations      PlatformConversation[]
  subscriptionCancellations  SubscriptionCancellation[]
  pageViews                  PageView[]

  id                        String        @id @default(cuid())
  organizationId            String?
  organization              Organization? @relation(fields: [organizationId], references: [id])
  name                      String
  logoUrl                   String?
  brandColor                String?
  address                   String?
  phone                     String?
  email                     String?
  etransferEnabled          Boolean       @default(false)
  etransferEmail            String?
  taxId                     String?
  currency                  String        @default("CAD")
  // Impuestos configurables por taller: lista de líneas {name, rate} (rate
  // como string decimal, ej. "0.05"). La suma de rates es la tasa combinada
  // por defecto para facturas/cotizaciones nuevas. Reemplaza el TPS+TVQ de
  // Quebec hardcodeado — cada taller define sus propios impuestos (uno, dos,
  // o ninguno). Ver src/lib/taxes.ts.
  taxLines                  Json          @default("[{\"name\":\"GST\",\"rate\":\"0.05\"},{\"name\":\"QST\",\"rate\":\"0.09975\"}]")
  appointmentReminderHours  Int           @default(24)
  appointmentEmailsEnabled  Boolean       @default(true)
  appointmentSmsEnabled     Boolean       @default(true)
  workOrderReadyNotifyEmail Boolean       @default(true)
  workOrderReadyNotifySms   Boolean       @default(true)
  // Confirmación de que el "email principal" (arriba) es alcanzable — null
  // hasta que se confirme. Se auto-marca al guardar si el valor coincide con
  // el correo de login del OWNER (ya forzoso-verificado, ver User.emailVerified).
  // Mientras no esté confirmado, resolveEffectiveShopContactEmail (sender-identity.ts)
  // usa el correo del OWNER en su lugar para reply-to/CC de cara al cliente —
  // nunca se manda nada a este campo sin confirmar.
  emailVerified             DateTime?
  slug                      String?       @unique
  bookingEnabled            Boolean       @default(false)
  timezone                  String        @default("America/Montreal")
  bookingSlotMinutes        Int           @default(60)
  bookingLeadTimeHours      Int           @default(24)
  bookingAdvanceDays        Int           @default(30)
  // Página pública de reservas (/book/[slug]) — configurador guiado, no un
  // page builder. Ver src/lib/booking-page.ts. Las fotos son opcionales: sin
  // ellas la página cae al fondo con color de marca de siempre. Plantilla y
  // tipografía guardan la preferencia del taller aunque su plan ya no la
  // incluya (downgrade): el render público resuelve el diseño efectivo.
  bookingCoverImageUrl      String?
  bookingShopImageUrl       String?
  bookingTemplate           BookingPageTemplate   @default(CLASSIC)
  bookingTypography         BookingPageTypography @default(GARAGE)
  // null = el taller nunca publicó desde el configurador → el admin ve el
  // asistente guiado; con fecha, ve el editor compacto.
  bookingPagePublishedAt    DateTime?
  createdAt                 DateTime      @default(now())
  // null = el taller (o esta ubicación adicional) todavía no terminó el
  // asistente de arranque — /admin redirige ahí. Ver src/app/admin/(shop)/onboarding.
  onboardingCompletedAt     DateTime?

  users                     User[]
  workingHours              ShopWorkingHours[]
  bookingServices           ShopBookingService[]
  clients                   Client[]
  invoices                  Invoice[]
  quotes                    Quote[]
  appointments              Appointment[]
  reminders                 ServiceReminder[]
  documents                 AccountingDocument[]
  savedLineItems            SavedLineItem[]
  cashDrawerEntries         CashDrawerEntry[]
  domains                   ShopDomain[]
  senderIdentities          SenderIdentity[]
  commRoutes                CommunicationRoute[]
  commMessages              CommunicationMessage[]
  commAuditLogs             CommunicationAuditLog[]
  commThreads               CommunicationThread[]
  suppressions              CommunicationSuppression[]
  campaigns                 Campaign[]
  appointmentEvents         AppointmentEvent[]
  smsNumber                 ShopSmsNumber?
  communicationsSuspendedAt DateTime?
  // Cupo mensual de segmentos SMS fijado por GarageOS para este taller —
  // reemplaza al de su plan (PLAN_LIMITS.smsSegmentsPerMonth). Null = el del plan.
  smsMonthlyAllowanceOverride Int?
  // Último umbral de uso de SMS avisado al taller ("2026-09:80" / "2026-09:100")
  // — evita repetir la alerta de 80 % / 100 % dentro del mismo mes.
  smsUsageAlertMarker       String?
  subscription              Subscription?

  @@schema("garageos")
}

/**
 * Billing/entitlements — ver docs/subscription-plans.md. Una fila por Shop "raíz"
 * (el primero de la organización, el único que se crea en signup). Para talleres
 * multi-sucursal, getEffectiveSubscription (src/lib/subscription.ts) resuelve por
 * Organization: cualquier Shop del mismo org comparte la misma Subscription — las
 * ubicaciones adicionales (createShopLocation) nunca crean su propia fila.
 * Un Shop sin fila aquí cae al plan por defecto (DEFAULT_PLAN) vía el mismo helper,
 * nunca directo a este modelo.
 */
model Subscription {
  id     String @id @default(cuid())
  shopId String @unique
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // null mientras el dueño todavía no elige plan en el onboarding
  // (status AWAITING_PLAN) — nunca se inventa un plan por defecto.
  plan             Plan?
  status           SubscriptionStatus
  billingInterval  BillingInterval?
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  cancelAtPeriodEnd Boolean           @default(false)

  // Primera vez que GarageOS observó past_due en Stripe (reloj de la gracia de 48 h → RESTRICTED).
  // Invariante: no nulo ⇔ status PAST_DUE. NO es updatedAt. Ver src/domain/subscription-state.ts.
  pastDueSince DateTime?

  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  stripePriceId        String?

  // Contacto de facturación — separado del contacto operativo del taller
  // (Shop.email). Relación comercial GarageOS↔taller, editable solo desde
  // /platform. Ver docs/super-admin-todo.md.
  billingEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cancellations SubscriptionCancellation[]

  @@schema("garageos")
}

/**
 * Eventos de webhook de Stripe ya procesados — idempotencia (Stripe reintenta
 * y puede entregar duplicados). La fila se inserta ANTES de procesar y se borra
 * si el handler falla, para que el reintento de Stripe sí lo vuelva a correr.
 */
model StripeWebhookEvent {
  id          String   @id // event.id de Stripe
  type        String
  processedAt DateTime @default(now())
  completedAt DateTime? @default(now())

  @@schema("garageos")
}

enum CancellationInitiator {
  OWNER
  SUPER_ADMIN
  STRIPE

  @@schema("garageos")
}

/**
 * Historial de cancelaciones/solicitudes de cancelación — nunca se
 * sobrescribe un campo, siempre se agrega una fila. Un taller puede
 * cancelar y reactivarse varias veces; cada evento queda registrado aquí.
 * Alimenta el % de cancelación de /platform.
 */
model SubscriptionCancellation {
  id                 String                @id @default(cuid())
  subscriptionId     String
  subscription       Subscription          @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  shopId             String
  shop               Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  planAtCancellation Plan
  reason             String                @db.Text
  initiatedBy        CancellationInitiator
  initiatedByUserId  String?
  effectiveAt        DateTime?
  createdAt          DateTime              @default(now())

  @@index([shopId, createdAt])
  @@schema("garageos")
}

enum Plan {
  CORE
  PRO
  COMPLETE

  @@schema("garageos")
}

enum SubscriptionStatus {
  // Taller recién creado: aún no eligió plan ni método de pago (onboarding).
  AWAITING_PLAN
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE

  @@schema("garageos")
}

enum BillingInterval {
  MONTHLY
  YEARLY

  @@schema("garageos")
}

model User {
  createdSalesDemos SalesDemo[]
  id              String          @id @default(cuid())
  shopId          String?
  shop            Shop?           @relation(fields: [shopId], references: [id])
  name            String
  email           String          @unique
  // Confirmación de que este correo es alcanzable — null hasta que la
  // persona haga click en el link de verificación (ver src/lib/email-verification.ts).
  // Un email sin confirmar no cuenta para recibir notificaciones de
  // facturación (ver resolveBillingNotificationRecipients en subscription.ts).
  emailVerified   DateTime?
  passwordHash    String?
  role            Role            @default(MECHANIC)
  bookable        Boolean         @default(true)
  preferredLocale InvoiceLanguage @default(EN)
  // Solo aplica a role OWNER — si un taller tiene varios dueños, cada uno
  // decide si quiere recibir los correos de facturación/cambios de plan.
  receiveBillingNotifications Boolean @default(true)
  // Permisos finos por usuario (Block 8, Pro+): otorgados / revocados sobre los del rol.
  // Solo cuentan con `permissions.advanced`; ver src/domain/permissions.ts.
  permissionGrants String[]       @default([])
  permissionDenies String[]       @default([])
  createdAt       DateTime        @default(now())

  accounts     Account[]
  sessions     Session[]
  appointments Appointment[]          @relation("AppointmentMechanic")
  workOrders   WorkOrder[]            @relation("WorkOrderMechanic")
  inspections  Inspection[]           @relation("InspectionMechanic")
  workingHours MechanicWorkingHours[]
  shopAccess   UserShopAccess[]
  staffNotifications           StaffNotification[]
  notificationPreferences      UserNotificationPreference[]
  // Platform-level Sales Workspace membership (NOT a tenant Role). See docs/sales-crm-agent-1-handoff.md.
  platformSalesStaff           PlatformSalesStaff?
  crmActivities                CrmActivity[]

  @@schema("garageos")
}

enum Role {
  SUPER_ADMIN
  OWNER
  MECHANIC
  VIEWER

  @@schema("garageos")
}

// Sales owns the lifecycle; deleting this record never deletes its Shop.
model SalesDemo {
  id String @id @default(cuid())
  shopId String @unique
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  createdByUserId String
  createdBy User @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  contactName String?
  contactEmail String?
  contactPhone String?
  preferredLanguage InvoiceLanguage @default(FR)
  currentPlan Plan @default(PRO)
  proposedPlan Plan @default(PRO)
  proposedBillingInterval BillingInterval @default(MONTHLY)
  status SalesDemoStatus @default(PREPARING)
  expiresAt DateTime
  activationSentAt DateTime?
  activatedAt DateTime?
  convertedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  activationTokenHash String? @unique
  activationExpiresAt DateTime?
  ownerName String?
  ownerEmail String?
  activatedOwnerId String? @unique
  retainScenario Boolean @default(true)
  checkoutAttemptId String? @unique
  checkoutAttemptAt DateTime?
  checkoutSessionId String? @unique
  communicationsEnabled Boolean @default(false)
  scenarioBatchId String? @unique
  // Commercial opportunity this technical demo belongs to (set only by the CRM; SalesDemo.status stays technical).
  crmOpportunityId String?
  crmOpportunity CrmOpportunity? @relation(fields: [crmOpportunityId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([createdByUserId, createdAt])
  @@index([crmOpportunityId])
  @@schema("garageos")
}

enum SalesDemoStatus {
  PREPARING
  ACTIVE
  ACTIVATION_SENT
  AWAITING_PAYMENT
  CONVERTED
  EXPIRED

  @@schema("garageos")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@schema("garageos")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("garageos")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@schema("garageos")
}

model Client {
  demoSeedBatchId String?
  workOrders  WorkOrder[]
  inspections Inspection[]

  id        String          @id @default(cuid())
  shopId    String
  shop      Shop            @relation(fields: [shopId], references: [id])
  firstName String
  lastName  String?
  email     String?
  phone     String?
  address   String?
  notes     String?         @db.Text
  language  InvoiceLanguage @default(FR)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  // Consentimiento de marketing (Communications Platform §12) — separado de las
  // comunicaciones transaccionales, que nunca dependen de estos campos.
  marketingEmailConsent  Boolean   @default(false)
  marketingSmsConsent    Boolean   @default(false)
  consentSource          String?
  consentAt              DateTime?
  emailMarketingOptOutAt DateTime?
  smsMarketingOptOutAt   DateTime?
  // El cliente respondió STOP al número del taller: el operador bloquea todo SMS
  // (transaccional incluido) hasta que responda START. La fuente de verdad del
  // bloqueo es CommunicationSuppression (por teléfono); esto es para mostrarlo.
  smsOptOutAt            DateTime?
  // Preferencia de canal para avisos transaccionales (citas, vehículo listo) —
  // AUTO deja la política del taller (SMS primero, email de respaldo, ver
  // notifyAppointmentEvent). No aplica a campañas/marketing, que ya tienen su
  // propio opt-in/out. Elegible por el cliente (reserva web, link de gestión)
  // o por el taller en su ficha.
  notifyChannel          ClientNotifyChannel @default(AUTO)

  vehicles           Vehicle[]
  tireStorageSets    TireStorageSet[]
  invoices           Invoice[]
  quotes             Quote[]
  appointments       Appointment[]
  commMessages       CommunicationMessage[]
  commThreads        CommunicationThread[]
  campaignRecipients CampaignRecipient[]
  portalAccesses     CustomerPortalAccess[]

  @@schema("garageos")
}

model Vehicle {
  demoSeedBatchId String?
  workOrders  WorkOrder[]
  inspections Inspection[]

  id           String      @id @default(cuid())
  clientId     String
  client       Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  make         String
  model        String
  year         Int
  licensePlate String
  vin          String?
  color        String?
  mileageUnit  MileageUnit @default(KM)
  createdAt    DateTime    @default(now())

  invoiceVehicles InvoiceVehicle[]
  quoteVehicles   QuoteVehicle[]
  appointments    Appointment[]
  reminders       ServiceReminder[]
  tireStorageSets TireStorageSet[]

  @@schema("garageos")
}

enum ClientNotifyChannel {
  AUTO
  SMS
  EMAIL
  BOTH

  @@schema("garageos")
}

enum MileageUnit {
  KM
  MILES

  @@schema("garageos")
}

model Invoice {
  demoSeedBatchId String?
  sourceQuote Quote?      @relation("QuoteConversion")
  workOrders  WorkOrder[]

  id                String              @id @default(cuid())
  shopId            String
  shop              Shop                @relation(fields: [shopId], references: [id])
  clientId          String
  client            Client              @relation(fields: [clientId], references: [id])
  invoiceNumber     String
  status            InvoiceStatus       @default(DRAFT)
  issuedAt          DateTime            @default(now())
  dueAt             DateTime?
  paidAt            DateTime?
  sentAt            DateTime?
  emailSentAt       DateTime?
  emailSendCount    Int                 @default(0)
  smsSentAt         DateTime?
  smsSendCount      Int                 @default(0)
  downloadToken     String?             @unique
  clientPackagePath String?
  subtotal          Decimal             @db.Decimal(10, 2)
  taxRate           Decimal             @db.Decimal(6, 5)
  taxAmount         Decimal             @db.Decimal(10, 2)
  total             Decimal             @db.Decimal(10, 2)
  language          InvoiceLanguage     @default(FR)
  notes             String?             @db.Text
  pdfUrl            String?
  paymentMode       InvoicePaymentMode?
  paymentExtraPaths Json                @default("[]")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Fiscal snapshot (Block 9): impuestos por línea, número de registro fiscal del taller y moneda
  // FIJADOS al emitir la factura. El PDF y los reportes leen de aquí — cambiar Shop.taxLines /
  // Shop.taxId después NUNCA reescribe una factura histórica. Ver src/domain/fiscal.ts.
  taxSnapshot       Json?
  taxRegistration   String?
  currency          String              @default("CAD")

  vehicles          InvoiceVehicle[]
  paymentEntries    InvoicePaymentEntry[]
  cashDrawerEntries CashDrawerEntry[]
  refunds           InvoiceRefund[]

  @@unique([shopId, invoiceNumber])
  @@schema("garageos")
}

model InvoiceVehicle {
  id         String  @id @default(cuid())
  invoiceId  String
  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  vehicleId  String
  vehicle    Vehicle @relation(fields: [vehicleId], references: [id])
  mileageIn  Int?
  mileageOut Int?
  sortOrder  Int     @default(0)

  lineItems InvoiceLineItem[]

  @@schema("garageos")
}

enum InvoicePaymentMode {
  CARD
  CASH
  MIXED

  @@schema("garageos")
}

model InvoicePaymentEntry {
  id          String                    @id @default(cuid())
  invoiceId   String
  invoice     Invoice                   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  method      InvoicePaymentEntryMethod
  amount      Decimal                   @db.Decimal(10, 2)
  receiptPath String?
  sortOrder   Int                       @default(0)
  createdAt   DateTime                  @default(now())

  @@schema("garageos")
}

enum InvoicePaymentEntryMethod {
  CARD
  CASH
  ETRANSFER
  CHEQUE
  OTHER

  @@schema("garageos")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED

  @@schema("garageos")
}

enum InvoiceLanguage {
  ES
  EN
  FR

  @@schema("garageos")
}

/**
 * Reembolso de una factura pagada (Block 9). Inmutable: no se edita ni se borra; la factura
 * conserva su total y su snapshot, y el neto = total − Σ reembolsos. `taxLines` reparte el
 * impuesto reembolsado por línea del snapshot (GST/QST…) para que el resumen de impuestos netos
 * sea exacto. Sin onDelete cascade: una factura con reembolsos no se puede borrar.
 */
model InvoiceRefund {
  id          String                    @id @default(cuid())
  shopId      String
  shop        Shop                      @relation(fields: [shopId], references: [id])
  invoiceId   String
  invoice     Invoice                   @relation(fields: [invoiceId], references: [id])
  /// Monto reembolsado al cliente, impuestos incluidos.
  amount      Decimal                   @db.Decimal(10, 2)
  /// Parte de `amount` que corresponde a impuestos (suma de taxLines).
  taxAmount   Decimal                   @db.Decimal(10, 2)
  taxLines    Json                      @default("[]")
  method      InvoicePaymentEntryMethod
  reason      String
  refundedAt  DateTime                  @default(now())
  createdById String?
  createdAt   DateTime                  @default(now())

  @@index([shopId, refundedAt])
  @@index([invoiceId])
  @@schema("garageos")
}

/**
 * Bitácora financiera append-only (Block 9): emisión, edición, pago, reversa de pago, anulación,
 * borrado de borradores y reembolsos. No se actualiza ni se borra desde la aplicación. Sin FK a la
 * factura a propósito: el registro sobrevive aunque un borrador se elimine.
 */
model FinancialEvent {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id])
  invoiceId String?
  type      String
  actorId   String?
  amount    Decimal? @db.Decimal(10, 2)
  data      Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([shopId, createdAt])
  @@index([invoiceId])
  @@schema("garageos")
}

model InvoiceLineItem {
  id               String         @id @default(cuid())
  invoiceVehicleId String
  invoiceVehicle   InvoiceVehicle @relation(fields: [invoiceVehicleId], references: [id], onDelete: Cascade)
  description      String
  quantity         Decimal        @db.Decimal(8, 2)
  unitPrice        Decimal        @db.Decimal(10, 2)
  lineTotal        Decimal        @db.Decimal(10, 2)
  itemType         LineItemType   @default(LABOUR)
  warrantyTerm     String?
  sortOrder        Int            @default(0)

  @@schema("garageos")
}

model SavedLineItem {
  id          String       @id @default(cuid())
  shopId      String
  shop        Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  description String
  itemType    LineItemType @default(LABOUR)
  unitPrice   Decimal      @db.Decimal(10, 2)
  useCount    Int          @default(1)
  lastUsedAt  DateTime     @default(now()) @updatedAt

  @@unique([shopId, description])
  @@schema("garageos")
}

enum LineItemType {
  LABOUR
  PART
  OTHER

  @@schema("garageos")
}

model Quote {
  demoSeedBatchId String?
  approvals  QuoteApproval[]
  workOrders WorkOrder[]

  id                      String          @id @default(cuid())
  shopId                  String
  shop                    Shop            @relation(fields: [shopId], references: [id])
  clientId                String
  client                  Client          @relation(fields: [clientId], references: [id])
  quoteNumber             String
  status                  QuoteStatus     @default(DRAFT)
  issuedAt                DateTime        @default(now())
  validUntil              DateTime?
  sentAt                  DateTime?
  emailSentAt             DateTime?
  emailSendCount          Int             @default(0)
  smsSentAt               DateTime?
  smsSendCount            Int             @default(0)
  approvalToken           String?         @unique
  approvalTokenExpiresAt  DateTime?
  approvalTokenConsumedAt DateTime?
  convertedInvoiceId      String?         @unique
  convertedInvoice        Invoice?        @relation("QuoteConversion", fields: [convertedInvoiceId], references: [id])
  subtotal                Decimal         @db.Decimal(10, 2)
  taxRate                 Decimal         @db.Decimal(6, 5)
  taxAmount               Decimal         @db.Decimal(10, 2)
  total                   Decimal         @db.Decimal(10, 2)
  language                InvoiceLanguage @default(FR)
  notes                   String?         @db.Text
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  // Ver Invoice.taxSnapshot — se copia a la factura al convertir.
  taxSnapshot             Json?

  vehicles QuoteVehicle[]

  @@unique([shopId, quoteNumber])
  @@index([approvalTokenExpiresAt])
  @@schema("garageos")
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
  CANCELLED

  @@schema("garageos")
}

model QuoteVehicle {
  id         String  @id @default(cuid())
  quoteId    String
  quote      Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  vehicleId  String
  vehicle    Vehicle @relation(fields: [vehicleId], references: [id])
  mileageIn  Int?
  mileageOut Int?
  sortOrder  Int     @default(0)

  lineItems QuoteLineItem[]

  @@schema("garageos")
}

model QuoteLineItem {
  id             String       @id @default(cuid())
  quoteVehicleId String
  quoteVehicle   QuoteVehicle @relation(fields: [quoteVehicleId], references: [id], onDelete: Cascade)
  description    String
  quantity       Decimal      @db.Decimal(8, 2)
  unitPrice      Decimal      @db.Decimal(10, 2)
  lineTotal      Decimal      @db.Decimal(10, 2)
  itemType       LineItemType @default(LABOUR)
  warrantyTerm   String?
  sortOrder      Int          @default(0)

  @@schema("garageos")
}

model Appointment {
  demoSeedBatchId String?
  id                 String            @id @default(cuid())
  shopId             String
