 * nunca se edita quantityOnHand directo.
 */
model InventoryPart {
  id               String   @id @default(cuid())
  shopId           String
  shop             Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sku              String?
  name             String
  description      String?  @db.Text
  unitCost         Decimal? @db.Decimal(10, 2)
  unitPrice        Decimal  @db.Decimal(10, 2)
  quantityOnHand   Int      @default(0)
  reorderThreshold Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  movements     InventoryMovement[]
  workOrderLines WorkOrderLine[]

  @@unique([shopId, sku])
  @@index([shopId, name])
  @@schema("garageos")
}

model InventoryMovement {
  id        String                @id @default(cuid())
  shopId    String
  shop      Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  partId    String
  part      InventoryPart         @relation(fields: [partId], references: [id], onDelete: Cascade)
  type      InventoryMovementType
  quantity  Int
  note      String?
  // Orden de trabajo que originó el movimiento (CONSUMED al usar / RETURN al corregir o
  // cancelar) — el neto por (orden, pieza) es lo que ya está descontado (Block 3).
  workOrderId String?
  workOrder   WorkOrder?            @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  createdAt DateTime              @default(now())

  @@index([shopId, partId, createdAt])
  @@index([workOrderId])
  @@schema("garageos")
}

enum InventoryMovementType {
  RECEIVE
  ADJUSTMENT
  CONSUMED
  RETURN

  @@schema("garageos")
}

/**
 * Multi-sucursal (docs/feature-gap.md). Un Shop sin organizationId sigue
 * siendo un taller de una sola ubicación, sin cambios. "Ubicación accesible"
 * para un usuario es su User.shopId (siempre implícito) más lo que aparezca
 * en UserShopAccess — no requiere backfill de usuarios existentes.
 */
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  shops Shop[]

  @@schema("garageos")
}

/**
 * Contador atómico de folios por taller y tipo de documento (docs/domain-model.md
 * invariante 6). El upsert en allocateNextInvoiceNumber/allocateNextQuoteNumber
 * (src/lib/invoice-number.ts) usa el índice único de abajo como INSERT ... ON
 * CONFLICT — Postgres serializa transacciones concurrentes sobre la misma fila,
 * así que dos facturas creadas al mismo tiempo nunca pueden competir por el
 * mismo número. Reemplaza el asignador anterior por búsqueda de máximo.
 */
model DocumentSequence {
  id         String   @id @default(cuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  docType    String
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([shopId, docType])
  @@schema("garageos")
}

model UserShopAccess {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, shopId])
  @@index([shopId])
  @@schema("garageos")
}

model Inspection {
  id          String           @id @default(cuid())
  shopId      String
  shop        Shop             @relation(fields: [shopId], references: [id])
  clientId    String
  client      Client           @relation(fields: [clientId], references: [id])
  vehicleId   String
  vehicle     Vehicle          @relation(fields: [vehicleId], references: [id])
  workOrderId String?
  workOrder   WorkOrder?       @relation(fields: [workOrderId], references: [id])
  mechanicId  String?
  mechanic    User?            @relation("InspectionMechanic", fields: [mechanicId], references: [id])
  mileage     Int?
  notes       String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  items       InspectionItem[]
  // Link público del reporte para el cliente (DVI avanzado, Block 6). null = no compartido.
  shareToken  String?          @unique

  @@index([shopId])
  @@index([vehicleId])
  @@schema("garageos")
}

enum InspectionCondition {
  GOOD
  ATTENTION
  SERVICE_REQUIRED

  @@schema("garageos")
}

model InspectionItem {
  id           String              @id @default(cuid())
  inspectionId String
  inspection   Inspection          @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  category     String
  condition    InspectionCondition @default(GOOD)
  notes        String?             @db.Text
  sortOrder    Int                 @default(0)
  photos       InspectionPhoto[]

  @@schema("garageos")
}

model InspectionPhoto {
  id               String         @id @default(cuid())
  inspectionItemId String
  inspectionItem   InspectionItem @relation(fields: [inspectionItemId], references: [id], onDelete: Cascade)
  storagePath      String
  createdAt        DateTime       @default(now())

  @@schema("garageos")
}

// ---------------------------------------------------------------------------
// Panel de super admin (GarageOS administrando talleres) — docs/super-admin-todo.md.
// Todo vive bajo /platform, separado del mundo del taller (/admin). Nada aquí
// es visible para el dueño del taller salvo lo explícitamente expuesto (ej.
// el email de cambio de plan).
// ---------------------------------------------------------------------------

/**
 * Bitácora de toda acción sensible de super admin sobre un taller — reset de
 * password, cambio de plan, cancelación, impersonación, notas, suspensión de
 * comunicaciones. Toda acción nueva de /platform que toque datos de un
 * taller debe registrar una fila aquí; es la única fuente de "qué hizo
 * GarageOS y por qué" si algún día hay que auditar o resolver una disputa.
 */
model PlatformAuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  shopId      String?
  shop        Shop?    @relation(fields: [shopId], references: [id], onDelete: SetNull)
  action      String
  targetType  String
  targetId    String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([shopId, createdAt])
  @@index([actorUserId, createdAt])
  @@schema("garageos")
}

/** Notas internas del equipo de GarageOS sobre un taller — nunca visibles para el taller. */
model PlatformNote {
  id           String   @id @default(cuid())
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  authorUserId String
  body         String   @db.Text
  createdAt    DateTime @default(now())

  @@index([shopId, createdAt])
  @@schema("garageos")
}

enum PlatformConversationStatus {
  WAITING_HUMAN
  LIVE
  CLOSED

  @@schema("garageos")
}

enum PlatformMessageSender {
  SHOP
  SUPER_ADMIN
  SYSTEM

  @@schema("garageos")
}

/**
 * Soporte GarageOS↔taller — NO confundir con CommunicationThread (eso es
 * taller↔cliente). Arranca en WAITING_HUMAN porque el chatbot de IA todavía
 * no existe (queda planeado, ver conversación de diseño en
 * docs/super-admin-todo.md); cuando se conecte, alcanza con sumar un estado
 * inicial de bot y la llamada al bot en la creación, sin tocar este schema.
 */
model PlatformConversation {
  id             String                      @id @default(cuid())
  shopId         String
  shop           Shop                        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  subject        String?
  status         PlatformConversationStatus  @default(WAITING_HUMAN)
  staffAlertedAt DateTime?
  lastMessageAt  DateTime                    @default(now())
  // Última vez que el taller vio esta conversación — se actualiza al abrir
  // /admin/support (ver markSupportConversationRead en support.ts). Alimenta
  // el punto de "mensaje nuevo" en el sidebar del admin, no un correo.
  shopReadAt     DateTime?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  messages PlatformMessage[]

  @@index([status, lastMessageAt])
  @@index([shopId])
  @@schema("garageos")
}

model PlatformMessage {
  id             String                @id @default(cuid())
  conversationId String
  conversation   PlatformConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         PlatformMessageSender
  authorUserId   String?
  content        String                @db.Text
  createdAt      DateTime              @default(now())

  @@index([conversationId, createdAt])
  @@schema("garageos")
}

/**
 * Analytics de visitas de primera parte, sin cookies — mismo enfoque que
 * Montreal Spider Co (visitorHash es un hash unidireccional de IP+UA salado
 * por día, nunca se guarda IP cruda). Cubre el sitio de marketing y las
 * landings públicas de reserva (/book/[slug]); nunca rutas /admin o /platform.
 */
model PageView {
  id           String   @id @default(cuid())
  path         String
  locale       String   @default("en")
  referrerHost String   @default("")
  utmSource    String   @default("")
  utmMedium    String   @default("")
  utmCampaign  String   @default("")
  device       String   @default("desktop")
  browser      String   @default("")
  country      String   @default("")
  /** Slug del taller cuando la visita fue a /book/[slug] o su dominio propio — vacío en el sitio de marketing. */
  shopSlug     String   @default("")
  shopId       String?
  shop         Shop?    @relation(fields: [shopId], references: [id], onDelete: SetNull)
  visitorHash  String
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([visitorHash, createdAt])
  @@schema("garageos")
}

enum ShopSmsNumberStatus {
  REQUESTED
  PROVISIONING
  ACTIVE
  RELEASE_SCHEDULED
  RELEASED
  FAILED

  @@schema("garageos")
}

/**
 * Número SMS dedicado de un taller — una subcuenta de Twilio por taller con su
 * propio número, aprovisionado solo por GarageOS desde /platform (cuesta renta
 * mensual). El taller lo pide desde Configuración (REQUESTED) y un super admin
 * lo aprueba con un clic, lo que dispara la compra real en Twilio. Una fila por
 * taller: `shopId @unique` + la transición atómica a PROVISIONING es el candado
 * contra aprovisionar dos veces. La subcuenta se reutiliza si el taller vuelve a
 * pedir número. Ver src/lib/communications/sms-numbers.ts.
 */
model ShopSmsNumber {
  id                  String              @id @default(cuid())
  shopId              String              @unique
  shop                Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  status              ShopSmsNumberStatus
  subaccountSid       String?             @unique
  // E.164 mientras el número está en uso; se vacía al liberarlo (el número puede
  // terminar en otro taller) y queda copiado en releasedPhoneNumber.
  phoneNumber         String?             @unique
  phoneNumberSid      String?
  countryCode         String              @default("CA")
  areaCode            String?
  senderIdentityId    String?
  requestedAt         DateTime?
  requestedByUserId   String?
  provisionedAt       DateTime?
  provisionedByUserId String?
  releaseScheduledAt  DateTime?
  releaseReason       String?
  releasedAt          DateTime?
  releasedPhoneNumber String?
  lastError           String?             @db.Text
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([status, releaseScheduledAt])
  @@schema("garageos")
}

/**
 * Centro de notificaciones en la app — alertas internas al equipo del taller
 * (cita web nueva, cliente canceló, cotización decidida, uso/ciclo de vida de
 * SMS). Una fila por usuario destinatario (no por taller): así cada quien
 * marca su propia bandeja como leída sin afectar a los demás. El email es un
 * canal aparte (ver UserNotificationPreference) — esta tabla es la fuente de
 * verdad de "qué vio quién", no un log de envíos.
 */
model StaffNotification {
  id        String    @id @default(cuid())
  shopId    String
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Clave estable del evento (ej. "STAFF_NEW_WEB_BOOKING") — ver StaffEventKey
  // en src/lib/staff-notify.ts. String, no enum: igual que CommunicationAuditLog,
  // para poder agregar eventos sin migración.
  event     String
  title     String
  body      String    @db.Text
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([shopId, userId, readAt, createdAt])
  @@schema("garageos")
}

/**
 * Preferencia por usuario y por tipo de evento: verlo en la app, recibirlo
 * también por email, o ambos. Sin fila = default (in-app y email activos) —
 * ver DEFAULT_STAFF_NOTIFICATION_PREFERENCE en src/lib/staff-notify.ts.
 */
model UserNotificationPreference {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  event  String
  inApp  Boolean @default(true)
  email  Boolean @default(true)

  @@unique([userId, event])
  @@schema("garageos")
}

/**
 * Bitácora de importaciones de datos (Block 2): una fila por importación confirmada,
 * con el resumen — no guarda el archivo ni los datos de las filas.
 */
model ImportRun {
  id               String   @id @default(cuid())
  shopId           String
  shop             Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  userId           String?
  entity           String
  fileName         String
  duplicates       String
  totalRows        Int
  created          Int
  updated          Int
  skipped          Int
  errors           Int
  customersCreated Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([shopId, createdAt])
  @@schema("garageos")
}

/**
 * Tire Storage (Block 4, Pro+): un juego de llantas guardado por un cliente (y opcionalmente un
 * vehículo). `status` refleja si están físicamente en el taller; el historial de entradas,
 * salidas y cambios de ubicación vive en TireStorageEvent.
 */
model TireStorageSet {
  id              String            @id @default(cuid())
  shopId          String
  shop            Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client            @relation(fields: [clientId], references: [id])
  vehicleId       String?
  vehicle         Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  season          TireSeason
  brand           String?
  model           String?
  /// Medida normalizada, p.ej. 225/45R17.
  size            String
  quantity        Int               @default(4)
  condition       TireCondition     @default(GOOD)
  withRims        Boolean           @default(false)
  storageLocation String?
  status          TireStorageStatus @default(STORED)
  checkedInAt     DateTime          @default(now())
  checkedOutAt    DateTime?
  notes           String?           @db.Text
  /// Fecha esperada de retiro / cambio de temporada (día calendario del taller, sin hora). Base de los recordatorios.
  expectedPickupDate DateTime?      @db.Date
  /// Marcas de envío (idempotencia de negocio; la idempotencyKey del outbox es la segunda barrera).
  checkInNotifiedAt      DateTime?
  pickupReminder14SentAt DateTime?
  pickupReminder3SentAt  DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  events TireStorageEvent[]

  @@index([shopId, status])
  @@index([shopId, clientId])
  @@index([vehicleId])
  @@index([status, expectedPickupDate])
  @@schema("garageos")
}

model TireStorageEvent {
  id        String           @id @default(cuid())
  shopId    String
  shop      Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  setId     String
  set       TireStorageSet   @relation(fields: [setId], references: [id], onDelete: Cascade)
  type      TireStorageEventType
  location  String?
  note      String?
  userId    String?
  createdAt DateTime         @default(now())

  @@index([setId, createdAt])
  @@schema("garageos")
}

enum TireSeason {
  WINTER
  SUMMER
  ALL_SEASON

  @@schema("garageos")
}

enum TireCondition {
  NEW
  GOOD
  FAIR
  WORN

  @@schema("garageos")
}

enum TireStorageStatus {
  STORED
  CHECKED_OUT

  @@schema("garageos")
}

enum TireStorageEventType {
  CHECK_IN
  CHECK_OUT
  MOVED
  NOTIFIED

  @@schema("garageos")
}

/**
 * Plantilla reutilizable de inspección (DVI avanzado, Block 6): lista ordenada de puntos a
 * revisar que sustituye al checklist estándar al crear una inspección. Pro+.
 */
model InspectionTemplate {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name      String
  items     String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, name])
  @@schema("garageos")
}


// ── QuickBooks Online (Block 10, Pro+) ───────────────────────────────────────

enum QuickBooksConnectionStatus {
  ACTIVE
  /** El refresh token ya no sirve (revocado/vencido): hay que volver a conectar. */
  NEEDS_RECONNECT
  DISCONNECTED

  @@schema("garageos")
}

enum QuickBooksSyncStatus {
  PENDING
  SYNCED
  ERROR
  /** Retirado en QuickBooks (pago borrado por reversa / factura anulada). */
  REMOVED

  @@schema("garageos")
}

/**
 * Conexión OAuth de UN taller con UNA compañía de QuickBooks Online. Los tokens se guardan
 * cifrados (AES-256-GCM, src/lib/integrations-crypto.ts) y nunca salen del servidor.
 */
model QuickBooksConnection {
  id                    String                     @id @default(cuid())
  shopId                String                     @unique
  shop                  Shop                       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  realmId               String
  companyName           String?
  environment           String
  accessTokenEnc        String
  refreshTokenEnc       String
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime
  status                QuickBooksConnectionStatus @default(ACTIVE)
  lastError             String?
  connectedById         String?
  connectedAt           DateTime                   @default(now())
  disconnectedAt        DateTime?
  /// Solo se sincronizan facturas emitidas desde esta fecha (por defecto: el día de la conexión).
  syncStartDate         DateTime
  /// Mapeo de cuentas/impuestos de QuickBooks: { incomeAccountId, depositAccountId, taxCodeId, zeroTaxCodeId }.
  settings              Json                       @default("{}")
  lastSyncAt            DateTime?
  /// Candado de sincronización (una corrida por conexión a la vez).
  syncingSince          DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  @@schema("garageos")
}

/**
 * Estado de sincronización + ID externo por entidad de GarageOS. La llave única (taller, tipo, id
 * local) hace la sincronización idempotente: una entidad ya vinculada se ACTUALIZA, nunca se
 * duplica. `realmId` separa compañías: al reconectar a otra compañía los vínculos anteriores no se reutilizan.
 */
model QuickBooksSyncRecord {
  id            String               @id @default(cuid())
  shopId        String
  shop          Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  realmId       String
  entityType    String
  localId       String
  /// Documento padre en GarageOS (factura de un pago/reembolso): detecta pagos retirados por reversa.
  parentLocalId String?
  qboId         String?
  qboSyncToken  String?
  status        QuickBooksSyncStatus @default(PENDING)
  /// Hash del contenido enviado por última vez: sin cambios → no se reenvía.
  fingerprint   String?
  attempts      Int                  @default(0)
  lastAttemptAt DateTime?
  nextRetryAt   DateTime?
  lastError     String?
  /// Avisos no fatales (p. ej. QuickBooks calculó un impuesto distinto por centavos).
  warning       String?
  syncedAt      DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([shopId, realmId, entityType, localId])
  @@index([shopId, status])
  @@index([shopId, parentLocalId])
  @@schema("garageos")
}

/** Nonce de un solo uso del flujo OAuth (anti-CSRF + anti-replay), ligado a taller y usuario. */
model QuickBooksOAuthState {
  id        String    @id @default(cuid())
  nonce     String    @unique
  shopId    String
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
  @@schema("garageos")
}

/**
 * Acceso al Customer Portal (Block 13): enlace mágico de un cliente (Client = relación con UN taller).
 * Solo se guarda el hash SHA-256 del token (nunca el token): quien lee la BD no puede entrar. Vence
 * (`expiresAt`), se revoca (`revokedAt`) y toda consulta del portal se acota por (shopId, clientId).
 */
model CustomerPortalAccess {
  id          String    @id @default(cuid())
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  /// STAFF = enviado/generado por el taller; CUSTOMER_REQUEST = pedido por el cliente en la página del taller.
  createdVia  String
  createdById String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime?

  @@index([clientId, revokedAt])
  @@index([shopId])
  @@schema("garageos")
}

/**
 * Contador de ventana fija para rate limiting (Block 15). `id` = `<clave>:<índice de ventana>`; el
 * upsert con increment es atómico en Postgres, así que funciona entre instancias serverless.
 * Las filas vencidas las purga el cron diario.
 */
model RateLimitBucket {
  id        String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
  @@schema("garageos")
}

