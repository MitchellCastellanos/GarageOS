/// Platform staff profile (Sales Rep / Sales Manager) linked 1:1 to a User. The User keeps a harmless tenant role
/// (VIEWER, no shop); all sales authority comes from this row. Rows are never deleted: deactivation keeps attribution.
model PlatformSalesStaff {
  id                    String               @id @default(cuid())
  userId                String               @unique
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  role                  PlatformSalesRole    @default(SALES_REP)
  status                PlatformStaffStatus  @default(INVITED)
  managerId             String?
  manager               PlatformSalesStaff?  @relation("StaffManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports               PlatformSalesStaff[] @relation("StaffManager")
  title                 String?
  phone                 String?
  territories           String[]             @default([])
  /// Sales UI language (EN | FR only; validated in the application).
  uiLocale              InvoiceLanguage      @default(EN)
  timezone              String               @default("America/Toronto")
  /// Working mode. Independent of `role` (administrative), coverage and prospect ownership.
  salesMode             SalesMode            @default(REMOTE)
  /// CrmTerritory.key values this agent covers. Empty = every territory their mode permits.
  coverageTerritoryKeys String[]             @default([])
  // ── Corporate identity: `User.email` is the corporate login (@garage-os.ca once assigned); the personal recovery
  // address below is private, never used in prospect-facing mail, and must be verified before it can recover an account.
  recoveryEmail            String?
  recoveryEmailVerifiedAt  DateTime?
  pendingRecoveryEmail     String?
  pendingRecoveryTokenHash String?             @unique
  pendingRecoveryExpiresAt DateTime?
  // ── Profile contract for Agent 2 (messaging/calendar). Stored here, consumed there; nothing sends or books in Agent 1.
  displayName           String?
  signatureText         String?
  bookingSlug           String?              @unique
  bookingEnabled        Boolean              @default(false)
  defaultMeetingMinutes Int                  @default(30)
  meetingBufferMinutes  Int                  @default(10)
  /// Weekly availability template: { "mon": [["09:00","17:00"]], ... } interpreted in `timezone`.
  availability          Json                 @default("{}")
  // ── Invitation (hash only; the raw token is shown/emailed once)
  inviteTokenHash       String?              @unique
  inviteExpiresAt       DateTime?
  inviteSentAt          DateTime?
  activatedAt           DateTime?
  createdByUserId       String?
  deactivatedAt         DateTime?
  deactivatedByUserId   String?
  deactivationReason    String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  prospects     CrmProspect[]
  opportunities CrmOpportunity[]
  tasks         CrmTask[]
  senderIdentity CrmSenderIdentity?
  calendarSettings CrmSellerCalendar?
  emailThreads  CrmEmailThread[]
  enrollments   CrmSequenceEnrollment[]
  availabilityExceptions CrmAvailabilityException[]
  bookingLinks  CrmBookingLink[]
  videoLinks    CrmVideoLink[]
  meetings      CrmMeeting[]

  @@index([status, role])
  @@index([managerId])
  @@schema("garageos")
}

model CrmImportBatch {
  id              String          @id @default(cuid())
  createdByUserId String
  assignedStaffId String?
  filename        String
  fileHash        String
  status          CrmImportStatus @default(PREVIEWED)
  /// Sanitized, validated rows awaiting confirmation. Cleared (null) once the batch leaves PREVIEWED.
  rows            Json?
  summary         Json            @default("{}")
  /// Row-level errors/skips: only row number, field and reason code (never cell values).
  errors          Json            @default("[]")
  createdCount    Int             @default(0)
  skippedCount    Int             @default(0)
  errorCount      Int             @default(0)
  defaultSource   CrmLeadSource   @default(IMPORT)
  createdAt       DateTime        @default(now())
  completedAt     DateTime?

  prospects CrmProspect[]

  @@index([createdByUserId, createdAt])
  @@index([fileHash])
  @@schema("garageos")
}

/// A business being sold to. Deliberately NOT a Shop; a technical Shop only exists once a SalesDemo is prepared.
model CrmProspect {
  id                String              @id @default(cuid())
  name              String
  nameNormalized    String
  website           String?
  websiteDomain     String?
  address           String?
  city              String?
  province          String?
  postalCode        String?
  phone             String?
  phoneDigits       String?
  email             String?
  industry          CrmIndustry?
  shopSize          CrmShopSize?
  locationCount     Int                 @default(1)
  currentSoftware   String?
  source            CrmLeadSource       @default(OTHER)
  sourceDetail      String?
  /// Business-level language. UNKNOWN is a real state that needs a human decision.
  preferredLanguage CrmLanguage         @default(UNKNOWN)
  status            CrmProspectStatus   @default(ACTIVE)
  assignedStaffId   String?
  assignedStaff     PlatformSalesStaff? @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  tags              String[]            @default([])
  notes             String?
  /// Persistent opt-out: survives archive, re-import and reassignment.
  doNotContact      Boolean             @default(false)
  doNotContactAt    DateTime?
  importBatchId     String?
  importBatch       CrmImportBatch?     @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  mergedIntoId      String?
  createdByUserId   String
  archivedAt        DateTime?
  lastActivityAt    DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  contacts      CrmContact[]
  opportunities CrmOpportunity[]
  needs         CrmProspectNeed[]
  activities    CrmActivity[]
  tasks         CrmTask[]
  emailThreads  CrmEmailThread[]
  enrollments   CrmSequenceEnrollment[]

  @@index([assignedStaffId, status])
  @@index([status, createdAt])
  @@index([nameNormalized])
  @@index([websiteDomain])
  @@index([phoneDigits])
  @@index([city])
  @@schema("garageos")
}

model CrmContact {
  id                String       @id @default(cuid())
  prospectId        String
  prospect          CrmProspect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  name              String
  title             String?
  email             String?
  emailNormalized   String?
  phone             String?
  isPrimary         Boolean      @default(false)
  isDecisionMaker   Boolean      @default(false)
  /// Contact-specific override. null = inherit the prospect language (UNKNOWN is never stored here).
  preferredLanguage CrmLanguage?
  doNotContact      Boolean      @default(false)
  notes             String?
  archivedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  activities CrmActivity[]
  emailThreads CrmEmailThread[]
  enrollments  CrmSequenceEnrollment[]
  sendingBases CrmSendingBasis[]

  @@index([prospectId, archivedAt])
  @@index([emailNormalized])
  @@schema("garageos")
}

/// One commercial opportunity per sales attempt. At most ONE open (non-terminal) opportunity per prospect
/// (partial unique index CrmOpportunity_one_open_per_prospect, created in the migration).
model CrmOpportunity {
  id                   String              @id @default(cuid())
  prospectId           String
  prospect             CrmProspect         @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  assignedStaffId      String?
  assignedStaff        PlatformSalesStaff? @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  stage                CrmPipelineStage    @default(NEW)
  stageChangedAt       DateTime            @default(now())
  urgency              CrmLevel?
  estimatedPlan        Plan?
  /// CAD cents of normalized monthly recurring revenue (never annual contract totals).
  estimatedMrrCents    Int?
  expectedCloseDate    DateTime?
  lossReason           CrmLossReason?
  closeNote            String?
  closedAt             DateTime?
  /// Set by Agent 3's Stripe-confirmed conversion only; Agent 1 never writes WON.
  wonAt                DateTime?
  convertedShopId      String?
  // Explainable scoring (computed, stored with its breakdown) and human overrides
  fitScore             Int?
  fitBreakdown         Json                @default("{}")
  intentScore          Int?
  intentBreakdown      Json                @default("{}")
  scoreComputedAt      DateTime?
  fitScoreOverride     Int?
  fitOverrideReason    String?
  intentScoreOverride  Int?
  intentOverrideReason String?
  overriddenByUserId   String?
  overriddenAt         DateTime?
  createdByUserId      String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  stageEvents CrmStageEvent[]
  activities  CrmActivity[]
  tasks       CrmTask[]
  demos       SalesDemo[]

  @@index([assignedStaffId, stage])
  @@index([stage, stageChangedAt])
  @@index([prospectId, stage])
  @@schema("garageos")
}

model CrmStageEvent {
  id            String            @id @default(cuid())
  opportunityId String
  opportunity   CrmOpportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fromStage     CrmPipelineStage?
  toStage       CrmPipelineStage
  actorUserId   String
  note          String?
  createdAt     DateTime          @default(now())

  @@index([opportunityId, createdAt])
  @@index([toStage, createdAt])
  @@schema("garageos")
}

/// Configurable needs taxonomy. Built-in rows are seeded by the migration; Super Admin can retune/extend them.
model CrmNeedDefinition {
  id               String          @id @default(cuid())
  key              String          @unique
  category         CrmNeedCategory
  labelEn          String
  labelFr          String
  descriptionEn    String?
  descriptionFr    String?
  /// Stable feature key Agent 3 maps to demo/playbook steps (e.g. "booking", "work-orders", "dvi").
  suggestedFeature String
  /// Fit-score weight (1-30) and demo ordering are derived from it.
  weight           Int             @default(10)
  active           Boolean         @default(true)
  builtIn          Boolean         @default(false)
  sortOrder        Int             @default(100)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  prospectNeeds CrmProspectNeed[]

  @@index([active, sortOrder])
  @@schema("garageos")
}

model CrmProspectNeed {
  id               String            @id @default(cuid())
  prospectId       String
  prospect         CrmProspect       @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  definitionId     String
  definition       CrmNeedDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  severity         CrmNeedSeverity   @default(MEDIUM)
  priority         CrmLevel          @default(MEDIUM)
  basis            CrmEvidenceBasis  @default(INFERRED)
  evidence         String?
  notes            String?
  assessedByUserId String
  assessedAt       DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([prospectId, definitionId])
  @@index([definitionId])
  @@schema("garageos")
}

/// Immutable (append-only) timeline entries. Authorship is the real User and survives staff deactivation.
model CrmActivity {
  id            String              @id @default(cuid())
  prospectId    String
  prospect      CrmProspect         @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   CrmOpportunity?     @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  contactId     String?
  contact       CrmContact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  type          CrmActivityType
  outcome       CrmActivityOutcome?
  subject       String?
  body          String?
  metadata      Json                @default("{}")
  occurredAt    DateTime            @default(now())
  authorUserId  String
  author        User                @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  createdAt     DateTime            @default(now())

  @@index([prospectId, occurredAt])
  @@index([opportunityId, occurredAt])
  @@index([authorUserId, occurredAt])
  @@schema("garageos")
}

model CrmTask {
  id                String              @id @default(cuid())
  prospectId        String
  prospect          CrmProspect         @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  opportunityId     String?
  opportunity       CrmOpportunity?     @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  assignedStaffId   String?
  assignedStaff     PlatformSalesStaff? @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  type              CrmTaskType         @default(FOLLOW_UP)
  title             String
  notes             String?
  priority          CrmLevel            @default(MEDIUM)
  status            CrmTaskStatus       @default(OPEN)
  dueAt             DateTime
  completedAt       DateTime?
  completedByUserId String?
  createdByUserId   String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([assignedStaffId, status, dueAt])
  @@index([status, dueAt])
  @@index([prospectId, status])
  @@schema("garageos")
}

/// Append-only audit trail for CRM + staff administration. Metadata never holds secrets or message bodies.
model CrmAuditEvent {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  entityType  String
  entityId    String?
  prospectId  String?
  staffId     String?
  before      Json?
  after       Json?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([prospectId, createdAt])
  @@index([staffId, createdAt])
  @@index([actorUserId, createdAt])
  @@schema("garageos")
}

// ─────────────────────────────────────────────────────────────────────────────────────────────
// Sales communications & scheduling (Agent 2). Platform-level commercial messaging: NEVER shares rows with
// tenant CommunicationThread/Message (shop↔customer) or PlatformConversation (support). No shopId anywhere.
// ─────────────────────────────────────────────────────────────────────────────────────────────

enum CrmIdentityStatus {
  DRAFT
  ACTIVE
  DISABLED

  @@schema("garageos")
}

enum CrmThreadStatus {
  OPEN
  DONE
  SPAM

  @@schema("garageos")
}

enum CrmEmailDirection {
  INBOUND
  OUTBOUND

  @@schema("garageos")
}

/// COMMERCIAL = solicitation (CASL basis + unsubscribe enforced); REPLY = answer inside a thread the contact started or
/// replied to; TRANSACTIONAL = meeting confirmations/reminders the contact asked for.
enum CrmEmailCategory {
  COMMERCIAL
  REPLY
  TRANSACTIONAL

  @@schema("garageos")
}

enum CrmEmailStatus {
  DRAFT
  SCHEDULED
  QUEUED
  SENDING
  SENT
  DELIVERED
  DELAYED
  BOUNCED
  COMPLAINED
  FAILED
  CANCELLED
  RECEIVED

  @@schema("garageos")
}

enum CrmSuppressionReason {
  UNSUBSCRIBE
  HARD_BOUNCE
  COMPLAINT
  MANUAL
  REPLY_OPT_OUT

  @@schema("garageos")
}

enum CrmSendingBasisKind {
  EXPRESS_CONSENT
  IMPLIED_EXISTING_RELATIONSHIP
  IMPLIED_PUBLISHED_ADDRESS
  IMPLIED_DISCLOSED_ADDRESS
  EXEMPT

  @@schema("garageos")
}

enum CrmSequenceStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED

  @@schema("garageos")
}

enum CrmEnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  STOPPED

  @@schema("garageos")
}

enum CrmMeetingType {
  VIDEO
  PHONE
  ON_SITE

  @@schema("garageos")
}

enum CrmMeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW

  @@schema("garageos")
}

enum CrmMeetingOutcome {
  HELD_INTERESTED
  HELD_NEEDS_FOLLOW_UP
  HELD_NOT_INTERESTED
  NO_SHOW
  RESCHEDULE_REQUESTED

  @@schema("garageos")
}

enum CrmAvailabilityExceptionKind {
  OFF
  EXTRA

  @@schema("garageos")
}

enum CrmBookingLinkKind {
  GENERAL
  PROSPECT

  @@schema("garageos")
}

/// Singleton ("default") configuration of the sales communications system. Nothing here is a secret.
enum CrmInboundProvider {
  RESEND
  CLOUDFLARE

  @@schema("garageos")
}

model CrmCommsSettings {
  id                  String   @id @default("default")
  /// Master kill switch. false ⇒ no commercial or transactional sales email leaves the system.
  sendingEnabled      Boolean  @default(false)
  /// Domains identities may send from (e.g. "sales.garage-os.ca"). A sender outside this list is refused.
  approvedDomains     String[] @default([])
  /// Domain (a Resend domain with receiving enabled) whose MX points at the provider; replies are routed here.
  inboundDomain       String?
  /// How replies reach GarageOS: RESEND (Resend receiving, needs the provider's MX) or CLOUDFLARE (Email Routing → Email Worker → authenticated endpoint).
  inboundProvider     CrmInboundProvider @default(RESEND)
  /// Shared mailbox local part for replies (e.g. "replies" ⇒ replies+<key>@<inboundDomain>). null ⇒ each seller's own local part.
  inboundReplyLocal   String?
  /// CASL: sender identification + mailing address printed in every commercial email footer.
  legalName           String   @default("GarageOS")
  mailingAddress      String?
  contactEmail        String?
  contactPhone        String?
  websiteUrl          String   @default("https://www.garage-os.ca")
  /// Hard ceiling on commercial messages per seller per local day (an identity may lower it, never raise it).
  defaultDailyLimit   Int      @default(30)
  /// Local sending window for sequences (seller timezone), whole hours.
  sendWindowStartHour Int      @default(8)
  sendWindowEndHour   Int      @default(17)
  /// Meeting rules applied to every seller.
  minNoticeMinutes    Int      @default(240)
  maxAdvanceDays      Int      @default(45)
  updatedByUserId     String?
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())

  @@schema("garageos")
}

/// A real, provider-backed sender. Active ONLY when Super Admin enabled it AND its domain is approved; "ready" is
/// computed from live provider state, never from this row alone (see domain/sales-comms/sender-setup.ts).
model CrmSenderIdentity {
  id                String             @id @default(cuid())
  staffId           String             @unique
  staff             PlatformSalesStaff @relation(fields: [staffId], references: [id], onDelete: Restrict)
  fromName          String
  fromEmail         String             @unique
  /// Local part used for replies. Replies go to `<replyLocal>+<threadKey>@<inboundDomain>` when inbound is set up.
  replyToEmail      String?
  jobTitle          String?
  phone             String?
  signatureText     String?
  defaultLanguage   CrmLanguage        @default(EN)
  status            CrmIdentityStatus  @default(DRAFT)
  dailyLimit        Int?
  /// Set the first time a REAL inbound message addressed to this identity's reply route is received and matched.
  inboundVerifiedAt DateTime?
  /// Set by Super Admin after seeing the provider confirm the sending domain; informational (live check wins).
  sendingCheckedAt  DateTime?
  createdByUserId   String
  updatedByUserId   String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  threads  CrmEmailThread[]
  messages CrmEmailMessage[]

  @@index([status])
  @@schema("garageos")
}

/// Approved, versioned template. A row's content is immutable once approved; editing creates version n+1.
/// Built-in defaults (code) are version 0 and apply when no row exists for the (key, language).
model CrmEmailTemplate {
  id               String           @id @default(cuid())
  key              String
  language         CrmLanguage
  version          Int
  category         CrmEmailCategory @default(COMMERCIAL)
  name             String
  subject          String
  bodyText         String
  active           Boolean          @default(true)
  approvedByUserId String
  approvedAt       DateTime         @default(now())
  createdAt        DateTime         @default(now())

  @@unique([key, language, version])
  @@index([key, language, active])
  @@schema("garageos")
}

model CrmEmailThread {
  id                String              @id @default(cuid())
  /// Random key embedded in the Reply-To plus-address; the only credential-free routing handle for replies.
  replyKey          String              @unique
  subject           String
  prospectId        String?
  prospect          CrmProspect?        @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  contactId         String?
  contact           CrmContact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunityId     String?
  identityId        String
  identity          CrmSenderIdentity   @relation(fields: [identityId], references: [id], onDelete: Restrict)
  /// Owner (seller) who may read the thread. Reassignable; Super Admin sees all.
  ownerStaffId      String?
  owner             PlatformSalesStaff? @relation(fields: [ownerStaffId], references: [id], onDelete: SetNull)
  status            CrmThreadStatus     @default(OPEN)
  /// Counterparty address (normalized) used for fallback matching.
  counterpartyEmail String?
  needsReply        Boolean             @default(false)
  lastInboundAt     DateTime?
  lastOutboundAt    DateTime?
  lastMessageAt     DateTime            @default(now())
  /// Owner has read everything up to this instant (unread = lastInboundAt > ownerSeenAt).
  ownerSeenAt       DateTime?
  language          CrmLanguage         @default(UNKNOWN)
  createdByUserId   String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  messages CrmEmailMessage[]
  notes    CrmEmailNote[]

  @@index([ownerStaffId, status, lastMessageAt])
  @@index([prospectId, lastMessageAt])
  @@index([counterpartyEmail])
  @@index([status, needsReply])
  @@schema("garageos")
}

/// Every email — inbound, outbound, draft, scheduled — and the durable outbox: an outbound row in QUEUED/SCHEDULED
/// with `nextAttemptAt` IS the job. Claiming is a compare-and-set on `status` (see lib/sales-comms/dispatcher.ts).
model CrmEmailMessage {
  id                     String            @id @default(cuid())
  threadId               String
  thread                 CrmEmailThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  identityId             String
  identity               CrmSenderIdentity @relation(fields: [identityId], references: [id], onDelete: Restrict)
  direction              CrmEmailDirection
  category               CrmEmailCategory  @default(COMMERCIAL)
  status                 CrmEmailStatus    @default(DRAFT)
  authorUserId           String?
  prospectId             String?
  contactId              String?
  opportunityId          String?
  fromAddress            String
  fromName               String?
  toAddresses            String[]
  ccAddresses            String[]          @default([])
  bccAddresses           String[]          @default([])
  subject                String
  bodyText               String?
  /// Our own rendered HTML (escaped text → branded layout). Inbound HTML is never stored or rendered.
  bodyHtml               String?
  provider               String            @default("resend")
  providerMessageId      String?
  internetMessageId      String?
  inReplyTo              String?
  references             String[]          @default([])
  /// Other Message-IDs this message is known by (the provider may assign its own); used for reply matching.
  altMessageIds          String[]               @default([])
  /// Out-of-office / bounce / list traffic: stored for the record but never counts as a human reply.
  isAutomated            Boolean                @default(false)
  // ── Provenance snapshots (never rewritten)
  templateKey            String?
  templateVersion        Int?
  language               CrmLanguage?
  languageSource         String?
  sequenceEnrollmentId   String?
  sequenceStepIndex      Int?
  meetingId              String?
  meetingEmailKind       String?
  // ── Durable outbox
  idempotencyKey         String?           @unique
  scheduledFor           DateTime?
  nextAttemptAt          DateTime?
  attempts               Int               @default(0)
  lockedAt               DateTime?
  sentAt                 DateTime?
  deliveredAt            DateTime?
  failedAt               DateTime?
  errorCode              String?
  errorMessage           String?
  inboundProviderEmailId String?           @unique
  receivedAt             DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  attachments CrmEmailAttachment[]
  events      CrmEmailDeliveryEvent[]

  @@index([threadId, createdAt])
  @@index([status, nextAttemptAt])
  @@index([providerMessageId])
  @@index([internetMessageId])
  @@index([meetingId])
  @@index([sequenceEnrollmentId])
  @@index([authorUserId, status])
  @@index([identityId, direction, sentAt])
  @@schema("garageos")
}

model CrmEmailAttachment {
  id         String          @id @default(cuid())
  messageId  String
  message    CrmEmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  sha256     String
  createdAt  DateTime        @default(now())

  @@index([messageId])
  @@schema("garageos")
}

model CrmEmailNote {
  id           String         @id @default(cuid())
  threadId     String
  thread       CrmEmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorUserId String
  body         String
  createdAt    DateTime       @default(now())

  @@index([threadId, createdAt])
  @@schema("garageos")
}

/// Webhook event ledger: `providerEventId` (the Svix delivery id) is unique ⇒ a replayed webhook is a no-op.
model CrmEmailDeliveryEvent {
  id              String           @id @default(cuid())
  providerEventId String           @unique
  messageId       String?
  message         CrmEmailMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  type            String
  providerEmailId String?
  detail          String?
  occurredAt      DateTime
  createdAt       DateTime         @default(now())

  @@index([messageId])
  @@index([providerEmailId])
  @@schema("garageos")
}

/// Global (all sellers, all sequences, all imports) email suppression. Rows are never deleted: lifting sets liftedAt.
model CrmEmailSuppression {
  id              String               @id @default(cuid())
  emailNormalized String
  reason          CrmSuppressionReason
  source          String
  messageId       String?
  note            String?
  createdByUserId String?
  createdAt       DateTime             @default(now())
  liftedAt        DateTime?
  liftedByUserId  String?
  liftNote        String?

  @@index([emailNormalized, liftedAt])
  @@index([createdAt])
  @@schema("garageos")
}

/// CASL: documented basis for sending commercial electronic messages to a contact. History is append-only; the
/// newest non-expired row wins. A contact with no valid basis cannot receive commercial email.
model CrmSendingBasis {
  id               String              @id @default(cuid())
  contactId        String
  contact          CrmContact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  kind             CrmSendingBasisKind
  evidence         String
  recordedAt       DateTime            @default(now())
  /// When the consent lapses (e.g. 24 months after last purchase/inquiry); null = does not lapse.
  expiresAt        DateTime?
  recordedByUserId String
  revokedAt        DateTime?

  @@index([contactId, recordedAt])
  @@schema("garageos")
}

model CrmSequence {
  id                String            @id @default(cuid())
  name              String
  description       String?
  status            CrmSequenceStatus @default(DRAFT)
  /// Business days only (skip Sat/Sun and holidays). Day offsets then count business days.
  businessDaysOnly  Boolean           @default(true)
  createdByUserId   String
  activatedByUserId String?
  activatedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  steps       CrmSequenceStep[]
  enrollments CrmSequenceEnrollment[]

  @@index([status])
  @@schema("garageos")
}

model CrmSequenceStep {
  id          String      @id @default(cuid())
  sequenceId  String
  sequence    CrmSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  stepIndex   Int
  /// Business days after enrollment (step 0 is usually 0).
  dayOffset   Int
  templateKey String

  @@unique([sequenceId, stepIndex])
  @@schema("garageos")
}

model CrmSequenceEnrollment {
  id               String              @id @default(cuid())
  sequenceId       String
  sequence         CrmSequence         @relation(fields: [sequenceId], references: [id], onDelete: Restrict)
  prospectId       String
  prospect         CrmProspect         @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  contactId        String
  contact          CrmContact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  opportunityId    String?
  staffId          String
  staff            PlatformSalesStaff  @relation(fields: [staffId], references: [id], onDelete: Restrict)
  status           CrmEnrollmentStatus @default(ACTIVE)
  /// Index of the NEXT step to send.
  nextStepIndex    Int                 @default(0)
  nextRunAt        DateTime?
  languageOverride CrmLanguage?
  startedAt        DateTime            @default(now())
  completedAt      DateTime?
  stoppedAt        DateTime?
  stopReason       String?
  enrolledByUserId String
  stoppedByUserId  String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([status, nextRunAt])
  @@index([prospectId, status])
  @@index([contactId, status])
  @@index([staffId, status])
  @@schema("garageos")
}

model CrmAvailabilityException {
  id              String                       @id @default(cuid())
  staffId         String
  staff           PlatformSalesStaff           @relation(fields: [staffId], references: [id], onDelete: Cascade)
  kind            CrmAvailabilityExceptionKind
  startsAt        DateTime
  endsAt          DateTime
  reason          String?
  createdByUserId String
  createdAt       DateTime                     @default(now())

  @@index([staffId, startsAt])
  @@schema("garageos")
}

/// Public booking link. 256-bit random opaque token (never derived from any id). PROSPECT links pre-bind the booking to a CRM prospect/contact without exposing their ids.
model CrmBookingLink {
  id              String             @id @default(cuid())
  token           String             @unique
  kind            CrmBookingLinkKind
  staffId         String
  staff           PlatformSalesStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  prospectId      String?
  contactId       String?
  opportunityId   String?
  active          Boolean            @default(true)
  expiresAt       DateTime?
  language        CrmLanguage?
  createdByUserId String
  createdAt       DateTime           @default(now())
  revokedAt       DateTime?

  meetings CrmMeeting[]

  @@index([staffId, kind, active])
  @@index([prospectId])
  @@schema("garageos")
}

/// A sales meeting (NOT a tenant Appointment). Times are UTC instants; `attendeeTimezone` is IANA.
model CrmMeeting {
  id                String             @id @default(cuid())
  staffId           String
  staff             PlatformSalesStaff @relation(fields: [staffId], references: [id], onDelete: Restrict)
  prospectId        String?
  contactId         String?
  opportunityId     String?
  bookingLinkId     String?
  bookingLink       CrmBookingLink?    @relation(fields: [bookingLinkId], references: [id], onDelete: SetNull)
  type              CrmMeetingType     @default(VIDEO)
  status            CrmMeetingStatus   @default(SCHEDULED)
  startsAt          DateTime
  endsAt            DateTime
  durationMinutes   Int
  staffTimezone     String
  attendeeTimezone  String
  attendeeName      String
  attendeeEmail     String
  attendeePhone     String?
  /// Phone number to call / address / meeting URL — only what was really configured; never an invented link.
  locationDetail    String?
  language          CrmLanguage        @default(EN)
  languageSource    String?
  agenda            String?
  notes             String?
  outcome           CrmMeetingOutcome?
  outcomeNotes      String?
  manageToken       String             @unique
  prepTaskId             String?
  /// Bumps on every reschedule; keys reminder idempotency and the ICS SEQUENCE.
  revision          Int                @default(0)
  rescheduledFromId String?
  cancelledAt       DateTime?
  cancelledBy       String?
  cancelReason      String?
  createdByUserId   String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([staffId, startsAt])
  @@index([prospectId, startsAt])
  @@index([status, startsAt])
  @@index([attendeeEmail])
  @@schema("garageos")
}

/// Seller-controlled calendar options. `joinUrl` is the seller's OWN meeting room (e.g. a personal Zoom/Meet/Teams
/// room they pasted); GarageOS never invents or auto-creates conference links.
model CrmSellerCalendar {
  staffId      String             @id
  staff        PlatformSalesStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  meetingTypes CrmMeetingType[]   @default([VIDEO, PHONE])
  durations    Int[]              @default([30])
  joinUrl      String?
  updatedAt    DateTime           @updatedAt

  @@schema("garageos")
}


/// Sales territory. The most specific active territory (lowest sortOrder) whose rules match a prospect's location wins.
model CrmTerritory {
  id                 String               @id @default(cuid())
  key                String               @unique
  nameEn             String
  nameFr             String
  acquisition        TerritoryAcquisition @default(REMOTE_DEFAULT)
  countryCode        String               @default("CA")
  /// Province codes (e.g. "QC"). Empty = any province.
  provinces          String[]             @default([])
  /// Normalised city names (lower case, no accents). A city OR postal-prefix match qualifies a location.
  cities             String[]             @default([])
  /// Canadian postal-code prefixes (FSA or first letter), upper case, no spaces.
  postalPrefixes     String[]             @default([])
  /// FIELD_PRIORITY only: days from `priorityStartedAt` during which FIELD agents hold initial acquisition.
  priorityDays       Int?
  priorityStartedAt  DateTime?
  active             Boolean              @default(true)
  sortOrder          Int                  @default(100)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([active, sortOrder])
  @@schema("garageos")
}

enum PublishStatus {
  DRAFT
  PUBLISHED

  @@schema("garageos")
}

/// Reusable marketing video (website + outreach). One row per (key, language); unpublished rows are never shown or sent.
model PlatformVideo {
  id             String        @id @default(cuid())
  key            String
  language       CrmLanguage
  title          String
  description    String?
  url            String
  thumbnailUrl   String?
  status         PublishStatus @default(DRAFT)
  allowWebsite   Boolean       @default(true)
  allowOutreach  Boolean       @default(true)
  publishedAt    DateTime?
  updatedByUserId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([key, language])
  @@schema("garageos")
}

// ── Sales video attribution ──────────────────────────────────────────────────────────────────────────────────────
/// Kinds of measurable video interaction. PAGE_VIEW is a client-confirmed view of the video page (NOT the same as a link
/// click: scanners and prefetchers fetch HTML but do not run the page script). PLAY needs a real user-initiated play.
enum CrmVideoEventType {
  PAGE_VIEW
  PLAY
  PROGRESS_25
  PROGRESS_50
  PROGRESS_75
  COMPLETE
  CTA_DEMO
  CTA_TRIAL

  @@schema("garageos")
}

/// Opaque, expiring, revocable attribution token for ONE (seller, prospect, contact, video, language). It is the only thing in a
/// public URL: no ids, no email, no name. Re-used when a seller inserts the same video twice.
model CrmVideoLink {
  id              String    @id @default(cuid())
  token           String    @unique
  staffId         String
  staff           PlatformSalesStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  prospectId      String
  contactId       String?
  /// "commercial" (60 s) or "teaser" (15 s) — a PlatformVideo key.
  videoKey        String
  language        CrmLanguage
  createdByUserId String
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?

  events   CrmVideoEvent[]
  messages CrmVideoLinkMessage[]

  @@index([prospectId])
  @@index([staffId])
  @@schema("garageos")
}

/// One row per (link, event type): first/last time, how many DISTINCT page views reported it. This is the dedupe: reloads,
/// retries and scanner re-fetches cannot inflate it.
model CrmVideoEvent {
  id          String            @id @default(cuid())
  linkId      String
  link        CrmVideoLink      @relation(fields: [linkId], references: [id], onDelete: Cascade)
  type        CrmVideoEventType
  count       Int               @default(1)
  firstAt     DateTime          @default(now())
  lastAt      DateTime          @default(now())
  lastViewKey String?

  @@unique([linkId, type])
  @@schema("garageos")
}

/// Which sent email carried which link (written when the message is queued), so activity can name the email/sequence.
model CrmVideoLinkMessage {
  linkId    String
  link      CrmVideoLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  messageId String
  createdAt DateTime     @default(now())

  @@id([linkId, messageId])
  @@index([messageId])
  @@schema("garageos")
}
