// GarageOS foundation adapted from Mecanico_Management; see docs/reuse-audit.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["garageos"]
}

model Shop {
  defaultLanguage    InvoiceLanguage     @default(FR)
  workOrders         WorkOrder[]
  inspections        Inspection[]
  inventoryParts     InventoryPart[]
  inventoryMovements InventoryMovement[]
  userAccess         UserShopAccess[]
  documentSequences  DocumentSequence[]

  id                        String        @id @default(cuid())
  organizationId            String?
  organization              Organization? @relation(fields: [organizationId], references: [id])
  name                      String
  logoUrl                   String?
  brandColor                String?
  address                   String?
  phone                     String?
  email                     String?
  billingEmail              String?
  infoEmail                 String?
  providersEmail            String?
  newsletterEmail           String?
  taxId                     String?
  currency                  String        @default("CAD")
  appointmentReminderHours  Int           @default(24)
  appointmentEmailsEnabled  Boolean       @default(true)
  appointmentSmsEnabled     Boolean       @default(true)
  workOrderReadyNotifyEmail Boolean       @default(true)
  workOrderReadyNotifySms   Boolean       @default(true)
  slug                      String?       @unique
  bookingEnabled            Boolean       @default(false)
  timezone                  String        @default("America/Montreal")
  bookingSlotMinutes        Int           @default(60)
  bookingLeadTimeHours      Int           @default(24)
  bookingAdvanceDays        Int           @default(30)
  createdAt                 DateTime      @default(now())

  users                     User[]
  workingHours              ShopWorkingHours[]
  bookingServices           ShopBookingService[]
  clients                   Client[]
  invoices                  Invoice[]
  quotes                    Quote[]
  appointments              Appointment[]
  reminders                 ServiceReminder[]
  documents                 AccountingDocument[]
  savedLineItems            SavedLineItem[]
  cashDrawerEntries         CashDrawerEntry[]
  domains                   ShopDomain[]
  senderIdentities          SenderIdentity[]
  commRoutes                CommunicationRoute[]
  commMessages              CommunicationMessage[]
  commAuditLogs             CommunicationAuditLog[]
  commThreads               CommunicationThread[]
  suppressions              CommunicationSuppression[]
  campaigns                 Campaign[]
  communicationsSuspendedAt DateTime?
  subscription              Subscription?

  @@schema("garageos")
}

/**
 * Billing/entitlements — ver docs/subscription-plans.md. Una fila por Shop "raíz"
 * (el primero de la organización, el único que se crea en signup). Para talleres
 * multi-sucursal, getEffectiveSubscription (src/lib/subscription.ts) resuelve por
 * Organization: cualquier Shop del mismo org comparte la misma Subscription — las
 * ubicaciones adicionales (createShopLocation) nunca crean su propia fila.
 * Un Shop sin fila aquí cae al plan por defecto (DEFAULT_PLAN) vía el mismo helper,
 * nunca directo a este modelo.
 */
model Subscription {
  id     String @id @default(cuid())
  shopId String @unique
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  plan             Plan
  status           SubscriptionStatus @default(TRIALING)
  billingInterval  BillingInterval?
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  cancelAtPeriodEnd Boolean           @default(false)

  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  stripePriceId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("garageos")
}

enum Plan {
  CORE
  PRO
  COMPLETE

  @@schema("garageos")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE

  @@schema("garageos")
}

enum BillingInterval {
  MONTHLY
  YEARLY

  @@schema("garageos")
}

model User {
  id              String          @id @default(cuid())
  shopId          String?
  shop            Shop?           @relation(fields: [shopId], references: [id])
  name            String
  email           String          @unique
  passwordHash    String?
  role            Role            @default(MECHANIC)
  bookable        Boolean         @default(true)
  preferredLocale InvoiceLanguage @default(ES)
  createdAt       DateTime        @default(now())

  accounts     Account[]
  sessions     Session[]
  appointments Appointment[]          @relation("AppointmentMechanic")
  workOrders   WorkOrder[]            @relation("WorkOrderMechanic")
  inspections  Inspection[]           @relation("InspectionMechanic")
  workingHours MechanicWorkingHours[]
  shopAccess   UserShopAccess[]

  @@schema("garageos")
}

enum Role {
  SUPER_ADMIN
  OWNER
  MECHANIC
  VIEWER

  @@schema("garageos")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@schema("garageos")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("garageos")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@schema("garageos")
}

model Client {
  workOrders  WorkOrder[]
  inspections Inspection[]

  id        String          @id @default(cuid())
  shopId    String
  shop      Shop            @relation(fields: [shopId], references: [id])
  firstName String
  lastName  String?
  email     String?
  phone     String?
  address   String?
  notes     String?         @db.Text
  language  InvoiceLanguage @default(FR)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  // Consentimiento de marketing (Communications Platform §12) — separado de las
  // comunicaciones transaccionales, que nunca dependen de estos campos.
  marketingEmailConsent  Boolean   @default(false)
  marketingSmsConsent    Boolean   @default(false)
  consentSource          String?
  consentAt              DateTime?
  emailMarketingOptOutAt DateTime?
  smsMarketingOptOutAt   DateTime?

  vehicles           Vehicle[]
  invoices           Invoice[]
  quotes             Quote[]
  appointments       Appointment[]
  commMessages       CommunicationMessage[]
  commThreads        CommunicationThread[]
  campaignRecipients CampaignRecipient[]

  @@schema("garageos")
}

model Vehicle {
  workOrders  WorkOrder[]
  inspections Inspection[]

  id           String      @id @default(cuid())
  clientId     String
  client       Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  make         String
  model        String
  year         Int
  licensePlate String
  vin          String?
  color        String?
  mileageUnit  MileageUnit @default(KM)
  createdAt    DateTime    @default(now())

  invoiceVehicles InvoiceVehicle[]
  quoteVehicles   QuoteVehicle[]
  appointments    Appointment[]
  reminders       ServiceReminder[]

  @@schema("garageos")
}

enum MileageUnit {
  KM
  MILES

  @@schema("garageos")
}

model Invoice {
  sourceQuote Quote?      @relation("QuoteConversion")
  workOrders  WorkOrder[]

  id                String              @id @default(cuid())
  shopId            String
  shop              Shop                @relation(fields: [shopId], references: [id])
  clientId          String
  client            Client              @relation(fields: [clientId], references: [id])
  invoiceNumber     String
  status            InvoiceStatus       @default(DRAFT)
  issuedAt          DateTime            @default(now())
  dueAt             DateTime?
  paidAt            DateTime?
  sentAt            DateTime?
  emailSentAt       DateTime?
  emailSendCount    Int                 @default(0)
  smsSentAt         DateTime?
  smsSendCount      Int                 @default(0)
  downloadToken     String?             @unique
  clientPackagePath String?
  subtotal          Decimal             @db.Decimal(10, 2)
  taxRate           Decimal             @db.Decimal(6, 5)
  taxAmount         Decimal             @db.Decimal(10, 2)
  total             Decimal             @db.Decimal(10, 2)
  language          InvoiceLanguage     @default(FR)
  notes             String?             @db.Text
  pdfUrl            String?
  paymentMode       InvoicePaymentMode?
  paymentExtraPaths Json                @default("[]")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  vehicles          InvoiceVehicle[]
  paymentEntries    InvoicePaymentEntry[]
  cashDrawerEntries CashDrawerEntry[]

  @@unique([shopId, invoiceNumber])
  @@schema("garageos")
}

model InvoiceVehicle {
  id         String  @id @default(cuid())
  invoiceId  String
  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  vehicleId  String
  vehicle    Vehicle @relation(fields: [vehicleId], references: [id])
  mileageIn  Int?
  mileageOut Int?
  sortOrder  Int     @default(0)

  lineItems InvoiceLineItem[]

  @@schema("garageos")
}

enum InvoicePaymentMode {
  CARD
  CASH
  MIXED

  @@schema("garageos")
}

model InvoicePaymentEntry {
  id          String                    @id @default(cuid())
  invoiceId   String
  invoice     Invoice                   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  method      InvoicePaymentEntryMethod
  amount      Decimal                   @db.Decimal(10, 2)
  receiptPath String?
  sortOrder   Int                       @default(0)
  createdAt   DateTime                  @default(now())

  @@schema("garageos")
}

enum InvoicePaymentEntryMethod {
  CARD
  CASH

  @@schema("garageos")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED

  @@schema("garageos")
}

enum InvoiceLanguage {
  ES
  EN
  FR

  @@schema("garageos")
}

model InvoiceLineItem {
  id               String         @id @default(cuid())
  invoiceVehicleId String
  invoiceVehicle   InvoiceVehicle @relation(fields: [invoiceVehicleId], references: [id], onDelete: Cascade)
  description      String
  quantity         Decimal        @db.Decimal(8, 2)
  unitPrice        Decimal        @db.Decimal(10, 2)
  lineTotal        Decimal        @db.Decimal(10, 2)
  itemType         LineItemType   @default(LABOUR)
  warrantyTerm     String?
  sortOrder        Int            @default(0)

  @@schema("garageos")
}

model SavedLineItem {
  id          String       @id @default(cuid())
  shopId      String
  shop        Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  description String
  itemType    LineItemType @default(LABOUR)
  unitPrice   Decimal      @db.Decimal(10, 2)
  useCount    Int          @default(1)
  lastUsedAt  DateTime     @default(now()) @updatedAt

  @@unique([shopId, description])
  @@schema("garageos")
}

enum LineItemType {
  LABOUR
  PART
  OTHER

  @@schema("garageos")
}

model Quote {
  approvals  QuoteApproval[]
  workOrders WorkOrder[]

  id                      String          @id @default(cuid())
  shopId                  String
  shop                    Shop            @relation(fields: [shopId], references: [id])
  clientId                String
  client                  Client          @relation(fields: [clientId], references: [id])
  quoteNumber             String
  status                  QuoteStatus     @default(DRAFT)
  issuedAt                DateTime        @default(now())
  validUntil              DateTime?
  sentAt                  DateTime?
  emailSentAt             DateTime?
  emailSendCount          Int             @default(0)
  smsSentAt               DateTime?
  smsSendCount            Int             @default(0)
  approvalToken           String?         @unique
  approvalTokenExpiresAt  DateTime?
  approvalTokenConsumedAt DateTime?
  convertedInvoiceId      String?         @unique
  convertedInvoice        Invoice?        @relation("QuoteConversion", fields: [convertedInvoiceId], references: [id])
  subtotal                Decimal         @db.Decimal(10, 2)
  taxRate                 Decimal         @db.Decimal(6, 5)
  taxAmount               Decimal         @db.Decimal(10, 2)
  total                   Decimal         @db.Decimal(10, 2)
  language                InvoiceLanguage @default(FR)
  notes                   String?         @db.Text
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  vehicles QuoteVehicle[]

  @@unique([shopId, quoteNumber])
  @@index([approvalTokenExpiresAt])
  @@schema("garageos")
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
  CANCELLED

  @@schema("garageos")
}

model QuoteVehicle {
  id         String  @id @default(cuid())
  quoteId    String
  quote      Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  vehicleId  String
  vehicle    Vehicle @relation(fields: [vehicleId], references: [id])
  mileageIn  Int?
  mileageOut Int?
  sortOrder  Int     @default(0)

  lineItems QuoteLineItem[]

  @@schema("garageos")
}

model QuoteLineItem {
  id             String       @id @default(cuid())
  quoteVehicleId String
  quoteVehicle   QuoteVehicle @relation(fields: [quoteVehicleId], references: [id], onDelete: Cascade)
  description    String
  quantity       Decimal      @db.Decimal(8, 2)
  unitPrice      Decimal      @db.Decimal(10, 2)
  lineTotal      Decimal      @db.Decimal(10, 2)
  itemType       LineItemType @default(LABOUR)
  warrantyTerm   String?
  sortOrder      Int          @default(0)

  @@schema("garageos")
}

model Appointment {
  id                 String            @id @default(cuid())
  shopId             String
  shop               Shop              @relation(fields: [shopId], references: [id])
  clientId           String
  client             Client            @relation(fields: [clientId], references: [id])
  vehicleId          String?
  vehicle            Vehicle?          @relation(fields: [vehicleId], references: [id])
  mechanicId         String?
  mechanic           User?             @relation("AppointmentMechanic", fields: [mechanicId], references: [id])
  title              String
  startsAt           DateTime
  endsAt             DateTime
  durationMinutes    Int
  status             AppointmentStatus @default(SCHEDULED)
  notes              String?           @db.Text
  confirmationSentAt DateTime?
  reminderSentAt     DateTime?
  cancellationSentAt DateTime?
  source             AppointmentSource @default(INTERNAL)
  manageToken        String?           @unique
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@schema("garageos")
}

enum AppointmentSource {
  INTERNAL
  PUBLIC_WEB

  @@schema("garageos")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW

  @@schema("garageos")
}

model ShopWorkingHours {
  id        String  @id @default(cuid())
  shopId    String
  shop      Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  openTime  String
  closeTime String
  isClosed  Boolean @default(false)

  @@unique([shopId, dayOfWeek])
  @@schema("garageos")
}

model MechanicWorkingHours {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  openTime  String
  closeTime String
  isClosed  Boolean @default(false)

  @@unique([userId, dayOfWeek])
  @@schema("garageos")
}

model ShopBookingService {
  id              String   @id @default(cuid())
  shopId          String
  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  labelFr         String
  labelEn         String
  labelEs         String
  durationMinutes Int
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@schema("garageos")
}

model ServiceReminder {
  id          String         @id @default(cuid())
  shopId      String
  shop        Shop           @relation(fields: [shopId], references: [id])
  vehicleId   String
  vehicle     Vehicle        @relation(fields: [vehicleId], references: [id])
  serviceType String
  dueMileage  Int?
  dueDate     DateTime?
  notes       String?
  status      ReminderStatus @default(PENDING)
  sentAt      DateTime?
  createdAt   DateTime       @default(now())

  @@schema("garageos")
}

enum ReminderStatus {
  PENDING
  SENT
  ACKNOWLEDGED
  DISMISSED

  @@schema("garageos")
}

model AccountingDocument {
  id            String      @id @default(cuid())
  shopId        String
  shop          Shop        @relation(fields: [shopId], references: [id])
  category      DocCategory
  fileName      String
  storagePath   String
  driveFileId   String?
  driveFolderId String?
  uploadedAt    DateTime    @default(now())
  uploadedById  String?
  notes         String?

  @@schema("garageos")
}

enum DocCategory {
  INVOICES
  RECEIPTS
  PAYROLL
  TAX_DOCUMENTS
  BANK_STATEMENTS
  OTHER

  @@schema("garageos")
}

model CashDrawerEntry {
  id              String                     @id @default(cuid())
  shopId          String
  shop            Shop                       @relation(fields: [shopId], references: [id])
  type            CashDrawerEntryType
  amount          Decimal                    @db.Decimal(10, 2)
  description     String?                    @db.Text
  occurredAt      DateTime                   @default(now())
  linkedInvoiceId String?
  linkedInvoice   Invoice?                   @relation(fields: [linkedInvoiceId], references: [id], onDelete: SetNull)
  paymentMethod   InvoicePaymentEntryMethod?
  createdById     String?
  createdAt       DateTime                   @default(now())

  @@index([shopId, occurredAt])
  @@index([linkedInvoiceId])
  @@schema("garageos")
}

enum CashDrawerEntryType {
  OPENING_BALANCE
  CASH_IN
  CASH_OUT
  ADJUSTMENT
  CLOSING_BALANCE

  @@schema("garageos")
}

// New GarageOS concepts. Application services must enforce same-shop ownership,
// approval revision matching and transactional conversion; see docs/domain-model.md.
model QuoteApproval {
  id               String           @id @default(cuid())
  quoteId          String
  quote            Quote            @relation(fields: [quoteId], references: [id])
  decision         ApprovalDecision
  documentHash     String
  documentSnapshot Json
  actorName        String
  recordedAt       DateTime         @default(now())
  channel          String

  @@index([quoteId, recordedAt])
  @@schema("garageos")
}

enum ApprovalDecision {
  ACCEPTED
  REJECTED

  @@schema("garageos")
}

model WorkOrder {
  id                       String          @id @default(cuid())
  shopId                   String
  shop                     Shop            @relation(fields: [shopId], references: [id])
  clientId                 String
  client                   Client          @relation(fields: [clientId], references: [id])
  vehicleId                String
  vehicle                  Vehicle         @relation(fields: [vehicleId], references: [id])
  quoteId                  String?
  quote                    Quote?          @relation(fields: [quoteId], references: [id])
  invoiceId                String?
  invoice                  Invoice?        @relation(fields: [invoiceId], references: [id])
  mechanicId               String?
  mechanic                 User?           @relation("WorkOrderMechanic", fields: [mechanicId], references: [id])
  orderNumber              String
  status                   WorkOrderStatus @default(OPEN)
  jobStatus                JobStatus       @default(CHECKED_IN)
  readyForPickupNotifiedAt DateTime?
  concern                  String
  diagnosis                String?         @db.Text
  mileageIn                Int?
  mileageOut               Int?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  lines                    WorkOrderLine[]
  inspections              Inspection[]

  @@unique([shopId, orderNumber])
  @@index([shopId, status])
  @@index([shopId, jobStatus])
  @@schema("garageos")
}

enum JobStatus {
  CHECKED_IN
  WAITING_APPROVAL
  WAITING_PARTS
  IN_SERVICE
  READY_FOR_PICKUP
  COMPLETED

  @@schema("garageos")
}

model WorkOrderLine {
  id           String       @id @default(cuid())
  workOrderId  String
  workOrder    WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  description  String
  quantity     Decimal      @db.Decimal(8, 2)
  unitPrice    Decimal      @db.Decimal(10, 2)
  itemType     LineItemType @default(LABOUR)
  warrantyTerm String?
  sortOrder    Int          @default(0)

  @@schema("garageos")
}

enum WorkOrderStatus {
  OPEN
  AWAITING_APPROVAL
  APPROVED
  IN_PROGRESS
  COMPLETED
  INVOICED
  CANCELLED

  @@schema("garageos")
}

/**
 * Dominio propio de un taller, para dos usos independientes: enviar sus
 * correos transaccionales desde su dominio (vía Resend) o exponer su
 * landing/booking en su propio dominio en vez de /book/[slug]. Un taller
 * puede tener a lo más un dominio por propósito. Ver docs/domain-model.md.
 */
model ShopDomain {
  id            String            @id @default(cuid())
  shopId        String
  shop          Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  purpose       ShopDomainPurpose
  domain        String
  status        ShopDomainStatus  @default(PENDING)
  dnsRecords    Json              @default("[]")
  providerId    String?
  lastCheckedAt DateTime?
  verifiedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  senderIdentities SenderIdentity[]

  @@unique([shopId, purpose])
  @@unique([domain, purpose])
  @@schema("garageos")
}

enum ShopDomainPurpose {
  EMAIL
  LANDING

  @@schema("garageos")
}

enum ShopDomainStatus {
  PENDING
  VERIFIED
  FAILED

  @@schema("garageos")
}

/**
 * Fundación de Communications Platform (Fase 1) — ver docs/communications-platform.md.
 * SenderIdentity/CommunicationRoute son hoy un espejo sincronizado de los campos de
 * email de Shop (no la fuente de verdad de envío todavía); email-config.ts sigue
 * resolviendo el From/Reply-To real. Cuando exista una UI de rutas (Fase 2), la
 * dirección de sincronización se invierte y esta tabla pasa a ser la fuente de verdad.
 * CommunicationMessage es el log/outbox: cada envío existente queda registrado aquí
 * con idempotencyKey para evitar reintentos duplicados (ver docs/domain-model.md #9).
 */
enum SenderIdentityType {
  GARAGEOS_MANAGED
  CUSTOM_DOMAIN

  @@schema("garageos")
}

enum SenderIdentityStatus {
  PENDING
  ACTIVE
  SUSPENDED
  FAILED

  @@schema("garageos")
}

enum CommChannel {
  EMAIL
  SMS

  @@schema("garageos")
}

enum CommDirection {
  INBOUND
  OUTBOUND
  SYSTEM

  @@schema("garageos")
}

enum CommMessageType {
  HUMAN
  TRANSACTIONAL
  CAMPAIGN
  SYSTEM_EVENT

  @@schema("garageos")
}

enum CommStatus {
  DRAFT
  QUEUED
  SENDING
  SENT
  DELIVERED
  FAILED
  BOUNCED
  RECEIVED

  @@schema("garageos")
}

model SenderIdentity {
  id                     String               @id @default(cuid())
  shopId                 String
  shop                   Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  channel                CommChannel
  type                   SenderIdentityType   @default(GARAGEOS_MANAGED)
  address                String
  // Para identidades GARAGEOS_MANAGED, `address` vive en el dominio compartido
  // (ej. slug@garage-os.ca) y `replyTo` es el correo real del taller — así las
  // respuestas del cliente llegan a su bandeja normal aunque el envío técnico
  // salga autenticado desde el dominio de GarageOS. Para CUSTOM_DOMAIN, replyTo
  // suele ser igual a address. Null = usar address como reply-to (compat legado).
  replyTo                String?
  displayName            String?
  domainId               String?
  domain                 ShopDomain?          @relation(fields: [domainId], references: [id])
  status                 SenderIdentityStatus @default(ACTIVE)
  verifiedAt             DateTime?
  // Fase 6 (aislamiento SMS por taller) — solo se llenan si se aprovisiona una
  // subcuenta/número dedicado de Twilio; ver src/lib/communications/sms-provisioning.ts.
  // No se usan todavía en ningún flujo activo.
  providerAccountSid     String?
  providerPhoneNumberSid String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  routes   CommunicationRoute[]
  messages CommunicationMessage[]

  @@unique([shopId, channel, address])
  @@schema("garageos")
}

model CommunicationRoute {
  id               String         @id @default(cuid())
  shopId           String
  shop             Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  purpose          String
  channel          CommChannel
  senderIdentityId String
  senderIdentity   SenderIdentity @relation(fields: [senderIdentityId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([shopId, purpose, channel])
  @@schema("garageos")
}

model CommunicationMessage {
  id                 String               @id @default(cuid())
  shopId             String
  shop               Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  clientId           String?
  client             Client?              @relation(fields: [clientId], references: [id])
  threadId           String?
  thread             CommunicationThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)
  direction          CommDirection        @default(OUTBOUND)
  channel            CommChannel
  messageType        CommMessageType      @default(TRANSACTIONAL)
  status             CommStatus           @default(QUEUED)
  provider           String?
  providerMessageId  String?
  internetMessageId  String?
  inReplyTo          String?
  references         String[]
  senderIdentityId   String?
  senderIdentity     SenderIdentity?      @relation(fields: [senderIdentityId], references: [id])
  purpose            String?
  businessEntityType String?
  businessEntityId   String?
  idempotencyKey     String?              @unique
  from               String
  replyTo            String?
  to                 String[]
  cc                 String[]
  bcc                String[]
  subject            String?
  textBody           String?              @db.Text
  htmlBody           String?              @db.Text
  errorCode          String?
  errorMessage       String?              @db.Text
  sentAt             DateTime?
  deliveredAt        DateTime?
  failedAt           DateTime?
  createdByUserId    String?
  createdAt          DateTime             @default(now())

  attachments CommunicationAttachment[]

  @@index([shopId, businessEntityType, businessEntityId])
  @@index([shopId, createdAt])
  @@index([clientId])
  @@index([threadId])
  @@schema("garageos")
}

model CommunicationThread {
  id            String           @id @default(cuid())
  shopId        String
  shop          Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  clientId      String?
  client        Client?          @relation(fields: [clientId], references: [id])
  subject       String?
  status        CommThreadStatus @default(OPEN)
  lastMessageAt DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  messages CommunicationMessage[]

  @@index([shopId, status, lastMessageAt])
  @@index([clientId])
  @@schema("garageos")
}

enum CommThreadStatus {
  OPEN
  ARCHIVED

  @@schema("garageos")
}

model CommunicationAttachment {
  id         String               @id @default(cuid())
  shopId     String
  messageId  String
  message    CommunicationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename   String
  mimeType   String
  size       Int
  storageKey String
  createdAt  DateTime             @default(now())

  @@index([shopId])
  @@schema("garageos")
}

/**
 * Auditoría de acciones sensibles de Communications (Fase 2/7) — creación/renombre de
 * identidades, reasignación de rutas, altas de supresión, envíos de campaña.
 */
model CommunicationAuditLog {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  actorUserId String?
  action      String
  targetType  String
  targetId    String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([shopId, createdAt])
  @@schema("garageos")
}

enum SuppressionReason {
  BOUNCE
  COMPLAINT
  UNSUBSCRIBE
  MANUAL

  @@schema("garageos")
}

/**
 * Direcciones a las que no se debe volver a enviar (Fase 5/7, doc §12.3). Se revisa
 * antes de cada envío de campaña; los envíos transaccionales no se filtran por aquí.
 */
model CommunicationSuppression {
  id        String            @id @default(cuid())
  shopId    String
  shop      Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  channel   CommChannel
  address   String
  reason    SuppressionReason
  createdAt DateTime          @default(now())

  @@unique([shopId, channel, address])
  @@schema("garageos")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED

  @@schema("garageos")
}

/**
 * Newsletter/outreach (Fase 5, doc §11) — el envío real lo procesa el cron de
 * campañas en lotes, nunca de forma síncrona desde una request web.
 */
model Campaign {
  id              String         @id @default(cuid())
  shopId          String
  shop            Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name            String
  channel         CommChannel    @default(EMAIL)
  subject         String?
  bodyHtml        String         @db.Text
  /**
   * Definición estructurada del segmento (nunca SQL/filtro arbitrario del tenant) — ver src/lib/communications/segments.ts.
   */
  segment         Json           @default("{}")
  status          CampaignStatus @default(DRAFT)
  scheduledFor    DateTime?
  sentAt          DateTime?
  createdByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  recipients CampaignRecipient[]

  @@index([shopId, status])
  @@schema("garageos")
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  BOUNCED
  SKIPPED_SUPPRESSED
  SKIPPED_NO_CONSENT

  @@schema("garageos")
}

/**
 * Snapshot inmutable de la audiencia al momento de crear la campaña — doc §11.3.
 */
model CampaignRecipient {
  id         String                  @id @default(cuid())
  campaignId String
  campaign   Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  clientId   String
  client     Client                  @relation(fields: [clientId], references: [id])
  address    String
  status     CampaignRecipientStatus @default(PENDING)
  messageId  String?
  createdAt  DateTime                @default(now())

  @@unique([campaignId, clientId])
  @@index([campaignId, status])
  @@schema("garageos")
}

/**
 * Inventario/refacciones (docs/feature-gap.md). `quantityOnHand` es un total
 * denormalizado — la única fuente de verdad del historial es InventoryMovement;
 * todo cambio de cantidad pasa por recordInventoryMovement() en una transacción,
 * nunca se edita quantityOnHand directo.
 */
model InventoryPart {
  id               String   @id @default(cuid())
  shopId           String
  shop             Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sku              String?
  name             String
  description      String?  @db.Text
  unitCost         Decimal? @db.Decimal(10, 2)
  unitPrice        Decimal  @db.Decimal(10, 2)
  quantityOnHand   Int      @default(0)
  reorderThreshold Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  movements InventoryMovement[]

  @@unique([shopId, sku])
  @@index([shopId, name])
  @@schema("garageos")
}

model InventoryMovement {
  id        String                @id @default(cuid())
  shopId    String
  shop      Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  partId    String
  part      InventoryPart         @relation(fields: [partId], references: [id], onDelete: Cascade)
  type      InventoryMovementType
  quantity  Int
  note      String?
  createdAt DateTime              @default(now())

  @@index([shopId, partId, createdAt])
  @@schema("garageos")
}

enum InventoryMovementType {
  RECEIVE
  ADJUSTMENT
  CONSUMED
  RETURN

  @@schema("garageos")
}

/**
 * Multi-sucursal (docs/feature-gap.md). Un Shop sin organizationId sigue
 * siendo un taller de una sola ubicación, sin cambios. "Ubicación accesible"
 * para un usuario es su User.shopId (siempre implícito) más lo que aparezca
 * en UserShopAccess — no requiere backfill de usuarios existentes.
 */
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  shops Shop[]

  @@schema("garageos")
}

/**
 * Contador atómico de folios por taller y tipo de documento (docs/domain-model.md
 * invariante 6). El upsert en allocateNextInvoiceNumber/allocateNextQuoteNumber
 * (src/lib/invoice-number.ts) usa el índice único de abajo como INSERT ... ON
 * CONFLICT — Postgres serializa transacciones concurrentes sobre la misma fila,
 * así que dos facturas creadas al mismo tiempo nunca pueden competir por el
 * mismo número. Reemplaza el asignador anterior por búsqueda de máximo.
 */
model DocumentSequence {
  id         String   @id @default(cuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  docType    String
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([shopId, docType])
  @@schema("garageos")
}

model UserShopAccess {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, shopId])
  @@index([shopId])
  @@schema("garageos")
}

model Inspection {
  id          String           @id @default(cuid())
  shopId      String
  shop        Shop             @relation(fields: [shopId], references: [id])
  clientId    String
  client      Client           @relation(fields: [clientId], references: [id])
  vehicleId   String
  vehicle     Vehicle          @relation(fields: [vehicleId], references: [id])
  workOrderId String?
  workOrder   WorkOrder?       @relation(fields: [workOrderId], references: [id])
  mechanicId  String?
  mechanic    User?            @relation("InspectionMechanic", fields: [mechanicId], references: [id])
  mileage     Int?
  notes       String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  items       InspectionItem[]

  @@index([shopId])
  @@index([vehicleId])
  @@schema("garageos")
}

enum InspectionCondition {
  GOOD
  ATTENTION
  SERVICE_REQUIRED

  @@schema("garageos")
}

model InspectionItem {
  id           String              @id @default(cuid())
  inspectionId String
  inspection   Inspection          @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  category     String
  condition    InspectionCondition @default(GOOD)
  notes        String?             @db.Text
  sortOrder    Int                 @default(0)
  photos       InspectionPhoto[]

  @@schema("garageos")
}

model InspectionPhoto {
  id               String         @id @default(cuid())
  inspectionItemId String
  inspectionItem   InspectionItem @relation(fields: [inspectionItemId], references: [id], onDelete: Cascade)
  storagePath      String
  createdAt        DateTime       @default(now())

  @@schema("garageos")
}
