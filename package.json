{
  "name": "garageos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/deploy-migrations.mjs && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run db:validate && npm run db:generate && npm run typecheck && npm test"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
