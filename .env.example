# Plantilla sin secretos — copiar a .env y completar.
# Development database only. No connection is needed for `npm run check`.

DATABASE_URL=postgresql://garageos:local_password@localhost:5432/garageos
DIRECT_URL=

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Login con Google (botón "Continuar con Google" en /admin/login).
# Crear en https://console.cloud.google.com/apis/credentials — tipo "OAuth
# client ID" / Web application, con redirect URI:
#   <NEXT_PUBLIC_APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RESEND_API_KEY=

# Dominio propio de GarageOS, verificado UNA vez en Resend (SPF/DKIM), usado para
# las identidades de envío "GARAGEOS_MANAGED" de todo taller que no conecte su
# propio dominio: <slug-del-taller>@EMAIL_MANAGED_DOMAIN. Recomendado: un
# subdominio dedicado a envío (ej. mail.garage-os.ca) en vez del dominio raíz.
EMAIL_MANAGED_DOMAIN=

# Dominios propios por taller (correo vía Resend, landing en /book/[slug]).
# Ver docs/domain-model.md. Opcionales — sin ellos, el fallback es el
# remitente compartido de GarageOS y la URL /book/{slug}.
# Dominio raíz que esta instancia controla, para el fallback {slug}.garageos.com
NEXT_PUBLIC_ROOT_DOMAIN=
# Host al que un taller debe apuntar su CNAME para usar su propio dominio en
# la landing. Por defecto usamos el host de NEXT_PUBLIC_APP_URL.
LANDING_DOMAIN_CNAME_TARGET=

# SMS de citas (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

EMAIL_FROM=
EMAIL_FROM_INVOICES=
EMAIL_FROM_REMINDERS=
EMAIL_FROM_ACCOUNTING=
EMAIL_FROM_WEB=

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

CRON_SECRET=

# PLATFORM_ADMIN_EMAIL=
# PLATFORM_ADMIN_PASSWORD=
# PLATFORM_ADMIN_NAME=

# Tarjeta de soporte en Configuración — opcional
# NEXT_PUBLIC_SUPPORT_NAME=
# NEXT_PUBLIC_SUPPORT_TAGLINE=
# NEXT_PUBLIC_SUPPORT_URL=
# NEXT_PUBLIC_SUPPORT_EMAIL=
# NEXT_PUBLIC_SUPPORT_PHONE=
# NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Suscripciones / Stripe — ver docs/subscription-plans.md ("Entitlement
# matrix") para qué desbloquea cada plan y la respuesta de configuración de
# Stripe para el texto exacto de cada producto/precio en el Dashboard.
# Checkout hospedado + Billing Portal — no se usa Stripe.js en el cliente,
# no hace falta publishable key.
STRIPE_SECRET_KEY=
# Developers → Webhooks → tu endpoint → "Signing secret" (empieza con whsec_)
STRIPE_WEBHOOK_SECRET=
# Product catalog → cada Price → "..." → Copy Price ID (empieza con price_)
STRIPE_PRICE_CORE_MONTHLY=
STRIPE_PRICE_CORE_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_COMPLETE_MONTHLY=
STRIPE_PRICE_COMPLETE_YEARLY=
