# Plantilla sin secretos — copiar a .env y completar.
# Development database only. No connection is needed for `npm run check`.

DATABASE_URL=postgresql://garageos:local_password@localhost:5432/garageos
DIRECT_URL=

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Login con Google (botón "Continuar con Google" en /admin/login).
# Crear en https://console.cloud.google.com/apis/credentials — tipo "OAuth
# client ID" / Web application, con redirect URI:
#   <NEXT_PUBLIC_APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RESEND_API_KEY=

# SMS de citas (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

EMAIL_FROM=
EMAIL_FROM_INVOICES=
EMAIL_FROM_REMINDERS=
EMAIL_FROM_ACCOUNTING=
EMAIL_FROM_WEB=

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

CRON_SECRET=

# PLATFORM_ADMIN_EMAIL=
# PLATFORM_ADMIN_PASSWORD=
# PLATFORM_ADMIN_NAME=

# Tarjeta de soporte en Configuración — opcional
# NEXT_PUBLIC_SUPPORT_NAME=
# NEXT_PUBLIC_SUPPORT_TAGLINE=
# NEXT_PUBLIC_SUPPORT_URL=
# NEXT_PUBLIC_SUPPORT_EMAIL=
# NEXT_PUBLIC_SUPPORT_PHONE=
# NEXT_PUBLIC_SUPPORT_WHATSAPP=
